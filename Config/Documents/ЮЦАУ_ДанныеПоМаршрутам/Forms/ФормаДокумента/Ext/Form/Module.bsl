			Возврат НоменклатурнаяГруппаСсылка;  
		Иначе
			Сообщить("Не найдена номенклатурная группа: " + СтруктураОбъекта.Идентификатор + " Код: " + СтруктураОбъекта.Код + "  " + СтруктураОбъекта.Наименование);
			//тест
			//Возврат Неопределено;
		КонецЕсли;	
	
		
		//Возврат Неопределено; //Не надо ничего создавать
		
		Если СтруктураОбъекта.ЭтоГруппа Тогда
			ОбъектКакОбъект = Справочники.НоменклатурныеГруппы.СоздатьГруппу();
		Иначе	
			ОбъектКакОбъект = Справочники.НоменклатурныеГруппы.СоздатьЭлемент();
		КонецЕсли;

		ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
		ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование;    

		Если СтруктураОбъекта.Свойство("Родитель") Тогда 
			ОбъектКакОбъект.Родитель = ПолучитьНоменклатурнуюГруппу(СтруктураОбъекта.Родитель);
		КонецЕсли;
		
		ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					
		ОбъектКакОбъект.Записать();	
		
		Возврат ОбъектКакОбъект.Ссылка;
		
	Иначе        
		
		//Если СтруктураОбъекта.Код <> СсылкаВИБ.Код Тогда
		//	Сообщить("Отличается код для номенклатурной группы: " + СтруктураОбъекта.Идентификатор + " " + СтруктураОбъекта.Код + " СсылкаВИБ.Код: " + СсылкаВИБ.Код);
		//КонецЕсли;	
		//
		//Если СтруктураОбъекта.Наименование <> СсылкаВИБ.Наименование Тогда
		//	Сообщить("Отличается наименование для номенклатурной группы: " + СтруктураОбъекта.Идентификатор + " " + СтруктураОбъекта.Наименование + " СсылкаВИБ.Наименование: " + СсылкаВИБ.Наименование);
		//КонецЕсли;	

		//Возврат СсылкаВИБ;     
		
		//Сначала поиск по ссылке затем поиск по регистру "ПубличныеИдентификаторыСинхронизируемыхОбъектов"
		Если СтруктураОбъекта.Код = СсылкаВИБ.Код И СтруктураОбъекта.Наименование = СсылкаВИБ.Наименование Тогда // В точности нужный элемент
			//Сообщить("Отличается код для номенклатурной группы: " + СтруктураОбъекта.Идентификатор + " " + СтруктураОбъекта.Код + " СсылкаВИБ.Код: " + СсылкаВИБ.Код);
			Возврат СсылкаВИБ;     
		Иначе 
			НоменклатурнаяГруппаСсылка = ПолучитьОбъектПоИдентификатору(СтруктураОбъекта.Идентификатор);  //Получаем по ранее установленному соответствию
			Если НоменклатурнаяГруппаСсылка <> Неопределено Тогда
				Возврат НоменклатурнаяГруппаСсылка;  
