		//КонецЕсли;	

	КонецЕсли;
	
КонецФункции		

&НаСервере
Функция ПолучитьМаршрут(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.ЮЦАУ_Маршруты.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		Если СтруктураОбъекта.ЭтоГруппа Тогда
			ОбъектКакОбъект = Справочники.ЮЦАУ_Маршруты.СоздатьГруппу();
		Иначе	
			ОбъектКакОбъект = Справочники.ЮЦАУ_Маршруты.СоздатьЭлемент();
		КонецЕсли;

		ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
		ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование;    

		Если СтруктураОбъекта.Свойство("Родитель") Тогда 
			ОбъектКакОбъект.Родитель = ПолучитьМаршрут(СтруктураОбъекта.Родитель);
		КонецЕсли;
		
		ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					
		ОбъектКакОбъект.Записать();	
		
		Возврат ОбъектКакОбъект.Ссылка;
		
	Иначе
		Возврат СсылкаВИБ; 
	КонецЕсли;
	
КонецФункции		

&НаСервере
Функция ПолучитьПолФизлица(ПолСтрокой)
	
	Если ПолСтрокой = "Мужской" Тогда
		Возврат Перечисления.ПолФизическогоЛица.Мужской;
	ИначеЕсли ПолСтрокой = "Женский" Тогда
		Возврат Перечисления.ПолФизическогоЛица.Женский;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции	

&НаСервере
Функция ПолучитьФизлицо(СтруктураСтроки)
	
	Идентификатор = СтруктураСтроки.ФизлицоИдентификатор;
	ИНН = СтруктураСтроки.ФизлицоИНН;
	Наименование = СтруктураСтроки.ФизлицоНаименование;
	ПолСтрокой = СтруктураСтроки.ФизлицоПол;
	ДатаРождения = СтруктураСтроки.ФизлицоДатаРождения;
	
	ФизлицоСсылка = ПолучитьОбъектПоИдентификатору(Идентификатор);  //Получаем по ранее установленному соответствию
	Если ФизлицоСсылка <> Неопределено Тогда
		Возврат ФизлицоСсылка;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Сообщить("Не указан ИНН для физлица: " + Наименование);
		Возврат Неопределено;
	КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФизическиеЛица.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.Наименование = &Наименование
	|	И ФизическиеЛица.ИНН = &ИНН";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("ИНН", ИНН);
	
	ФизлицоСсылка = Неопределено;
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		ФизлицоСсылка = ВыборкаДетальныеЗаписи.Ссылка;  
		Прервать;
	КонецЦикла;
	
	Если ФизлицоСсылка = Неопределено Тогда
		
		Сообщить("Не удалось подобрать физлицо по наименованию: " + Наименование + " и ИНН: " + ИНН);
		Возврат ФизлицоСсылка; //Добавлять физлица из УАТ в автоматическом режиме не следует
		
	//	ФизлицоОбъект = Справочники.ФизическиеЛица.СоздатьЭлемент();
	//	ФизлицоОбъект.Наименование = Наименование;
	//	ФизлицоОбъект.ДатаРождения = ДатаРождения;
	//	ФизлицоОбъект.Пол = ПолучитьПолФизлица(ПолСтрокой);
	//	ФизлицоОбъект.ИНН = ИНН;
	//	ФизлицоОбъект.Записать(); 
	//	ФизлицоСсылка = ФизлицоОбъект.Ссылка;
		
	КонецЕсли;
	
	//Добавление физлица в регистр ПубличныеИдентификаторыСинхронизируемыхОбъектов
	НаборЗаписей = РегистрыСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов.СоздатьНаборЗаписей(); 

	НаборЗаписей.Отбор.Идентификатор.Установить(Идентификатор); 
	НаборЗаписей.Отбор.УзелИнформационнойБазы.Установить(Неопределено); 

	НоваяЗапись = НаборЗаписей.Добавить(); 
	НоваяЗапись.Идентификатор = Идентификатор; 
	НоваяЗапись.УзелИнформационнойБазы = Неопределено; 
	НоваяЗапись.Ссылка = ФизлицоСсылка; 

	НаборЗаписей.Записать(); 
	
	Возврат ФизлицоСсылка;
	
КонецФункции	


