&НаСервере
Процедура ЗаполнитьИзУАТНаСервере()
	
	//Подключение к УАТ
	ПараметрыПодключения = ЮЦАУ.ПолучитьПараметрыПодключения_УАТ(Объект.Организация);
	
	Если ПараметрыПодключения = Неопределено Тогда
		Сообщить("Не определены параметры подключения к УАТ!");
		Возврат;
	КонецЕсли;	
	
	Попытка		
		Если ПараметрыПодключения.Порт <= 0 Тогда 
			HTTPСоединение = Новый HTTPСоединение(ПараметрыПодключения.АдресСервера,,ПараметрыПодключения.Пользователь,ПараметрыПодключения.Пароль);
		Иначе 
			HTTPСоединение = Новый HTTPСоединение(ПараметрыПодключения.АдресСервера,ПараметрыПодключения.Порт,ПараметрыПодключения.Пользователь,ПараметрыПодключения.Пароль);
		КонецЕсли;	
	Исключение
		Сообщить("Не удалось подключиться по причине: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ДатаНачала = НачалоМесяца(Объект.Дата);
	ДатаКонца = КонецМесяца(Объект.Дата);
	//http://localhost/UAT/hs/api_uat/RouteData?StartDate=01.10.2022&EndDate=31.10.2022
	РесурсНаСервере = "/UAT/hs/api_uat/RouteData?StartDate="+Формат(ДатаНачала,"ДЛФ=Д")+"&EndDate="+Формат(ДатаКонца,"ДЛФ=Д");
	
	HTTPЗапрос = Новый HTTPЗапрос(РесурсНаСервере);
	HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод("GET", HTTPЗапрос);
			
	//Получаем ответный текст или текст ошибки  
	Если HTTPОтвет.КодСостояния = 401 Тогда
		Сообщить("Не удалось авторизоваться в программе УАТ. Неверный логин или пароль. HTTPОтвет.КодСостояния: " + HTTPОтвет.КодСостояния);
	ИначеЕсли HTTPОтвет.КодСостояния = 500 Тогда
		Сообщить("HTTPОтвет.КодСостояния: " + HTTPОтвет.КодСостояния);
	Иначе	

		СтрокаJSON = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ПолучитьСтруктуруИзJSON(СтрокаJSON);
		ДесериализоватьJSONИЗагрузитьДокументы(СтрокаJSON);  

	КонецЕсли;		
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТранспортноеСредство(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.ТранспортныеСредства.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		//Если СтруктураОбъекта.ЭтоГруппа Тогда
		//	ОбъектКакОбъект = Справочники.ТранспортныеСредства.СоздатьГруппу();   
		//	ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование; 
		//Иначе   

			ОбъектКакОбъект = Справочники.ТранспортныеСредства.СоздатьЭлемент();
			ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование; 
			ОбъектКакОбъект.РегистрационныйЗнак = СтруктураОбъекта.ГосударственныйНомер;  
			
			ОбъектКакОбъект.Модель = ПолучитьМодель(СтруктураОбъекта.Модель);
			ОбъектКакОбъект.ТипТС = ПолучитьТипТС(СтруктураОбъекта.ТипТС);

		//КонецЕсли;

		//Если СтруктураОбъекта.Свойство("Родитель") Тогда      //В Бух. необязательны группы ТС
		//	ОбъектКакОбъект.Родитель = ПолучитьТранспортноеСредство(СтруктураОбъекта.Родитель);	
		//КонецЕсли;	
		
		ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					
		ОбъектКакОбъект.Записать();
		
		Возврат ОбъектКакОбъект.Ссылка;	
		
	Иначе
		Возврат СсылкаВИБ; 
	КонецЕсли;
	
КонецФункции	

&НаСервере
Функция ПолучитьМодель(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.уатМоделиТС.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		Если СтруктураОбъекта.ЭтоГруппа Тогда
			ОбъектКакОбъект = Справочники.уатМоделиТС.СоздатьГруппу();
			ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
			ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование; 
		Иначе
			
			ОбъектКакОбъект = Справочники.уатМоделиТС.СоздатьЭлемент();
			ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
			ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование; 
			ОбъектКакОбъект.ВидМоделиТС = Перечисления.уатВидыМоделейТС.Автотранспорт;	
			
			ОбъектКакОбъект.ТипТС = ПолучитьТипТС(СтруктураОбъекта.ТипТС);
			
		КонецЕсли;		
		
		Если СтруктураОбъекта.Свойство("Родитель") Тогда 
			ОбъектКакОбъект.Родитель = ПолучитьМодель(СтруктураОбъекта.Родитель);	
		КонецЕсли;	
		
		ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					
		ОбъектКакОбъект.Записать();	

		Возврат ОбъектКакОбъект.Ссылка;
		
	Иначе
		Возврат СсылкаВИБ; 
	КонецЕсли;
	
КонецФункции	

&НаСервере
Функция ПолучитьТипТС(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.уатТипыТС.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		Если СтруктураОбъекта.ЭтоГруппа Тогда
			ОбъектКакОбъект = Справочники.уатТипыТС.СоздатьГруппу();
			ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
			ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование; 
		Иначе
			ОбъектКакОбъект = Справочники.уатТипыТС.СоздатьЭлемент();
			ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
			ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование; 
			ОбъектКакОбъект.ВидМоделиТС = Перечисления.уатВидыМоделейТС.Автотранспорт;	
			
			ОбъектКакОбъект.ТипТС = ПолучитьТипТС(СтруктураОбъекта.ТипТС);
		КонецЕсли;
		
		Если СтруктураОбъекта.Свойство("Родитель") Тогда 
			ОбъектКакОбъект.Родитель = ПолучитьТипТС(СтруктураОбъекта.Родитель);	
		КонецЕсли;	
		
		ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					
		ОбъектКакОбъект.Записать();	

		Возврат ОбъектКакОбъект.Ссылка;
		
	Иначе
		Возврат СсылкаВИБ; 
	КонецЕсли;
	
КонецФункции	

&НаСервере
Функция ПолучитьПодразделение(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.ПодразделенияОрганизаций.ПолучитьСсылку(УИДСсылки);
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		//Попытка поиска подразделения по идентификатору
		ПодразделениеСсылка = ПолучитьОбъектПоИдентификатору(СтруктураОбъекта.Идентификатор);
		Если ПодразделениеСсылка <> Неопределено Тогда   
			Возврат ПодразделениеСсылка;
		КонецЕсли;	
		
		Сообщить("Не найдено подразделение: " + СтруктураОбъекта.Идентификатор + " Код: " + СтруктураОбъекта.Код + "  " + СтруктураОбъекта.Наименование);
		Возврат Неопределено; 
		
	Иначе     

		Если СтруктураОбъекта.Код <> СсылкаВИБ.Код Тогда
			Сообщить("Отличается код для подразделения: " + СтруктураОбъекта.Идентификатор + " " + СтруктураОбъекта.Код + " СсылкаВИБ.Код: " + СсылкаВИБ.Код);
		КонецЕсли;	
		
		Если СтруктураОбъекта.Наименование <> СсылкаВИБ.Наименование Тогда
			Сообщить("Отличается наименование для подразделения: " + СтруктураОбъекта.Идентификатор + " " + СтруктураОбъекта.Наименование + " СсылкаВИБ.Наименование: " + СсылкаВИБ.Наименование);
		КонецЕсли;	

		Возврат СсылкаВИБ; 
		
	КонецЕсли;
	
КонецФункции		

&НаСервере
Процедура ДесериализоватьJSONИЗагрузитьДокументы(СтрокаJSON)
	
	СоздаватьОбъекты = Истина;
	
	МассивПолейДат = Новый Массив;
	МассивПолейДат.Добавить("Период");
	МассивПолейДат.Добавить("ДатаПериода");
	МассивПолейДат.Добавить("ФизлицоДатаРождения");
	СписокСтрок = ДесериализоватьJSON(СтрокаJSON, МассивПолейДат);	
	
	//Получение Основного маршрута для ТС
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЮЦАУ_ОсновныеМаршрутыТССрезПоследних.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ЮЦАУ_ОсновныеМаршрутыТССрезПоследних.Маршрут КАК Маршрут
		|ИЗ
		|	РегистрСведений.ЮЦАУ_ОсновныеМаршрутыТС.СрезПоследних(&ДатаПериода, ) КАК ЮЦАУ_ОсновныеМаршрутыТССрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТранспортноеСредство,
		|	Маршрут
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ДатаПериода", КонецМесяца(Объект.Дата));
	тзСоответствиеТСиМаршрута = Запрос.Выполнить().Выгрузить();

	//Получение Номенклатурной группы для маршрута
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЮЦАУ_СоответствиеМаршрутаИНоменклатурнойГруппыСрезПоследних.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
		|	ЮЦАУ_СоответствиеМаршрутаИНоменклатурнойГруппыСрезПоследних.Маршрут КАК Маршрут
		|ИЗ
		|	РегистрСведений.ЮЦАУ_СоответствиеМаршрутаИНоменклатурнойГруппы.СрезПоследних(&ДатаПериода, ) КАК ЮЦАУ_СоответствиеМаршрутаИНоменклатурнойГруппыСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаПериода", КонецМесяца(Объект.Дата));
	тзСоответствиеМаршрутаИНоменклатурнойГруппы = Запрос.Выполнить().Выгрузить();

	//Спецификация маршрутов
	Маршрут_Перегон = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("Маршрут_Перегон", Объект.Организация, Объект.Дата);
	Маршрут_Резерв = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("Маршрут_Резерв", Объект.Организация, Объект.Дата);
	Маршрут_ПеревозкаЛюдейПоГороду = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("Маршрут_ПеревозкаЛюдейПоГороду", Объект.Организация, Объект.Дата);
	ПодразделениеАвтоколоннаПассажирскиеПеревозки = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПодразделениеАвтоколоннаПассажирскиеПеревозки");
	
	Если Маршрут_Перегон = Неопределено Тогда
		Сообщить("Не установлено значение маршрута Маршрут_Перегон");
	КонецЕсли;	
	
	Если Маршрут_Резерв = Неопределено Тогда
		Сообщить("Не установлено значение маршрута Маршрут_Резерв");
	КонецЕсли;	

	Если Маршрут_ПеревозкаЛюдейПоГороду = Неопределено Тогда
		Сообщить("Не установлено значение маршрута Маршрут_ПеревозкаЛюдейПоГороду");
	КонецЕсли;	                  

	Если ПодразделениеАвтоколоннаПассажирскиеПеревозки = Неопределено Тогда
		Сообщить("Не установлено значение подразделения ПодразделениеАвтоколоннаПассажирскиеПеревозки");
	КонецЕсли;	                  

	Для Каждого СтруктураСтроки Из СписокСтрок.ДанныеПоМаршрутам Цикл
		
		ТранспортноеСредство = Неопределено;
		СчетЗатрат = Неопределено;
		Подразделение = Неопределено;
		
		Если СтруктураСтроки.Свойство("ТранспортноеСредство") Тогда
			ТранспортноеСредство = ПолучитьТранспортноеСредство(СтруктураСтроки.ТранспортноеСредство);
		КонецЕсли;	

		Если СтруктураСтроки.Свойство("Подразделение") Тогда
			Подразделение = ПолучитьПодразделение(СтруктураСтроки.Подразделение);
		КонецЕсли;	

		Маршрут = Неопределено;  
		НоменклатурнаяГруппа = Неопределено;
		Если Подразделение = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПодразделениеАвтоколоннаПассажирскиеПеревозки") Тогда
			
			СчетЗатрат = ПланыСчетов.Хозрасчетный.ЭксплуатацияМаршрутныхАвтобусов; //25.03
			Если СтруктураСтроки.Свойство("Маршрут") Тогда
				Маршрут = ПолучитьМаршрут(СтруктураСтроки.Маршрут);
			КонецЕсли;	

			//Обработка перегона и резерва     
			ОсновнойМаршрут = Маршрут;
			Если Маршрут = Неопределено ИЛИ Маршрут = Маршрут_Перегон ИЛИ Маршрут = Маршрут_Резерв ИЛИ Маршрут = Маршрут_ПеревозкаЛюдейПоГороду Тогда
					
				//Поиск основного маршрута для транспортного средства  
				НайденнаяСтрока = тзСоответствиеТСиМаршрута.Найти(ТранспортноеСредство, "ТранспортноеСредство"); 
				Если НайденнаяСтрока = Неопределено Тогда   
					Сообщить("Не удалось определить основной маршрут для ТС: " + ТранспортноеСредство);
				Иначе	
					ОсновнойМаршрут = НайденнаяСтрока.Маршрут;
				КонецЕсли;	
					
			КонецЕсли;	    
			
			//НоменклатурнаяГруппа = "";
			Если ОсновнойМаршрут <> Неопределено Тогда
				НайденнаяСтрока = тзСоответствиеМаршрутаИНоменклатурнойГруппы.Найти(ОсновнойМаршрут, "Маршрут"); 
				Если НайденнаяСтрока = Неопределено Тогда   
					Сообщить("Не удалось определить номенклатурную группу для маршрута: " + ОсновнойМаршрут);
				Иначе	
					НоменклатурнаяГруппа = НайденнаяСтрока.НоменклатурнаяГруппа;    
				КонецЕсли;	
			КонецЕсли;			

			Если Маршрут = Неопределено Тогда
				
				ТекстСообщения = "Не указан маршрут для ТС: " + ТранспортноеСредство;
				Если ЗначениеЗаполнено(НоменклатурнаяГруппа) Тогда
					ТекстСообщения = ТекстСообщения + ". По умолчанию будет использована номенклатурная группа: " + НоменклатурнаяГруппа;
				КонецЕсли;
				
				Сообщить(ТекстСообщения);
				
			КонецЕсли;			

		Иначе	//Номенклатурная группа для учета затрат по автотранспорту
			
			Если СтруктураСтроки.Свойство("НоменклатурнаяГруппа") Тогда                                 
				НоменклатурнаяГруппа = ПолучитьНоменклатурнуюГруппу(СтруктураСтроки.НоменклатурнаяГруппа);
			КонецЕсли;	
			
			СчетЗатрат = ПланыСчетов.Хозрасчетный.ЭксплуатацияДорожнойТехники; //25.02
			
		КонецЕсли;
		
		НоваяСтрока = Объект.ДанныеПоМаршрутам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
		НоваяСтрока.ТранспортноеСредство = ТранспортноеСредство;
		НоваяСтрока.Подразделение = Подразделение;
		НоваяСтрока.СчетЗатрат = СчетЗатрат;
		НоваяСтрока.Сотрудник = ПолучитьФизлицо(СтруктураСтроки);    
		НоваяСтрока.Маршрут = Маршрут; 
		НоваяСтрока.НоменклатурнаяГруппа = НоменклатурнаяГруппа;    
			
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНоменклатурнуюГруппу(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.НоменклатурныеГруппы.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		//Сообщить("Не найдена номенклатурная группа: " + СтруктураОбъекта.Идентификатор + " Код: " + СтруктураОбъекта.Код + "  " + СтруктураОбъекта.Наименование);

