// Функция для десериализации в JSON
&НаСервере
Функция ПолучитьСтруктуруИзJSON(СтрокаJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	СтруктураИзJSON = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Возврат СтруктураИзJSON;
	
КонецФункции	


&НаКлиенте
Процедура ЗаполнитьИзУАТ(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Сообщить("Не выбрана организация!");
		Возврат;
	КонецЕсли;	
	
	Если Объект.ДанныеПоМаршрутам.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением табличная часть будет очищена. Заполнить?'");
		Оповещение = Новый ОписаниеОповещения("ВопросПередЗаполнениемТабличнойЧастиДанныеПоМаршрутамЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
			НСтр("ru = 'Загрузка данных из УАТ'"));
	Иначе	
		ЗаполнитьИзУАТНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗаполнениемТабличнойЧастиДанныеПоМаршрутамЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.ДанныеПоМаршрутам.Очистить();
		ЗаполнитьИзУАТНаСервере();
	КонецЕсли;
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция ДесериализоватьJSON(СтрокаJSON, ПоляДат = "")

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	
	Объект = ПрочитатьJSON(ЧтениеJSON,, ПоляДат, ФорматДатыJSON.ISO);
	
	ЧтениеJSON.Закрыть();
	
	Возврат Объект;
	
КонецФункции


#КонецОбласти
