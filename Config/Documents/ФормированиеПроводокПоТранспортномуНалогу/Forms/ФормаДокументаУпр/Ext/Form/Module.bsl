Функция РасчетКоэффициента(ДатаРег, ДатаСнятияСРег, КолМес)
	Если ДатаРег<=Объект.НачалоПериода И (ДатаСнятияСРег>=Объект.КонецПериода ИЛИ ДатаСнятияСРег = '00010101') Тогда
		Коэф = 1;
	ИначеЕсли
		ДатаРег>Объект.НачалоПериода И (ДатаСнятияСРег>=Объект.КонецПериода ИЛИ ДатаСнятияСРег = '00010101')Тогда
		Коэф = Окр((Месяц(Объект.КонецПериода)-Месяц(ДатаРег)+1)/КолМес,4); 
	ИначеЕсли
		ДатаРег<=Объект.НачалоПериода И ДатаСнятияСРег<Объект.КонецПериода Тогда
		Коэф = Окр((Месяц(ДатаСнятияСРег)/КолМес),4);
	ИначеЕсли
		ДатаРег>Объект.НачалоПериода И ДатаСнятияСРег<Объект.КонецПериода Тогда
		Коэф = Окр((Месяц(ДатаСнятияСРег)-Месяц(ДатаРег)+1)/КолМес,4);
	КонецЕсли;	 
	Возврат Коэф;	
КонецФункции

Функция ПолучитьДатуСнятияСРегистрации(ОС)
	
	Запрос = Новый Запрос; 	
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("ВидЗаписи",Перечисления.ВидЗаписиОРегистрации.СнятиеСРегистрационногоУчета);
	Запрос.УстановитьПараметр("НачалоПериода",Объект.НачалоПериода); 	
	Запрос.УстановитьПараметр("КонецПериода",Объект.КонецПериода); 
	Запрос.УстановитьПараметр("ОсновноеСредство",ОС); 	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегистрацияТранспортныхСредств.Период
	|ИЗ
	|	РегистрСведений.РегистрацияТранспортныхСредств КАК РегистрацияТранспортныхСредств
	|ГДЕ
	|	РегистрацияТранспортныхСредств.Организация = &Организация
	|	И РегистрацияТранспортныхСредств.ВидЗаписи = &ВидЗаписи
	|	И РегистрацияТранспортныхСредств.ОсновноеСредство = &ОсновноеСредство";		
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДатаСнятияСРегистрации = Выборка.Период;
	Иначе ДатаСнятияСРегистрации = '00010101'; 	
	КонецЕсли;
	
	Возврат ДатаСнятияСРегистрации	
	
КонецФункции

Функция РасчетАванса(ОС)
	
	Запрос = Новый Запрос; 	
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода",Объект.НачалоПериода); 	
	Запрос.УстановитьПараметр("КонецПериода",ДобавитьМесяц(КонецДня(Объект.КонецПериода),-3)); 
	Запрос.УстановитьПараметр("ОсновноеСредство",ОС); 	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(НачисленияПоТранспортномуНалогу.СуммаНалога) КАК СуммаНалога
	|ИЗ
	|	РегистрНакопления.НачисленияПоТранспортномуНалогу КАК НачисленияПоТранспортномуНалогу
	|ГДЕ
	|	НачисленияПоТранспортномуНалогу.Организация = &Организация
	|	И НачисленияПоТранспортномуНалогу.ТранспортноеСредство = &ОсновноеСредство
	|	И НачисленияПоТранспортномуНалогу.Период МЕЖДУ &НачалоПериода И &КонецПериода";	
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СуммаАванса  = Выборка.СуммаНалога;
	Иначе СуммаАванса = 0; 	
	КонецЕсли;
	
	Возврат СуммаАванса	
	
КонецФункции	

