	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ДатаПериода));
	
	Граница = Новый Граница(КонецМесяца(ДатаПериода), ВидГраницы.Включая);
    Запрос.УстановитьПараметр("ОкончаниеПериода", Граница); 
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаУмолчаний = МассивРезультатов[2].Выгрузить();
	ТаблицаИтоговая = МассивРезультатов[3].Выгрузить();
	
	//Проверка необходимости добавления строк с умолчаниями (с нулевыми коэффициентами)
	Для Каждого ТекСтрока Из ТаблицаУмолчаний Цикл

		НайденнаяСтрока = ТаблицаИтоговая.Найти(ТекСтрока.ТранспортноеСредство, "ТранспортноеСредство"); 		
		
		Если НайденнаяСтрока = Неопределено Тогда
			НоваяСтрока = ТаблицаИтоговая.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат ТаблицаИтоговая;  

КонецФункции	

Процедура РаспределитьСуммуСписанияТоваровПоНоменклатурнымГруппам(ТекСтрока, ТаблицаРаспределения, тзОборотыПоТСиНоменклатурнымГруппам, Счет_25_03)
	
	//Уточнение субконто "Номенклатурная группа"
	//Если ТипЗнч(ТекСтрока.КорСубконто1) = Тип("СправочникСсылка.НоменклатурныеГруппы") Тогда
	//	СубконтоНоменклатурнаяГруппа = "КорСубконто1";
	//ИначеЕсли ТипЗнч(ТекСтрока.КорСубконто2) = Тип("СправочникСсылка.НоменклатурныеГруппы") Тогда
		СубконтоНоменклатурнаяГруппа = "КорСубконто2";
	//ИначеЕсли ТипЗнч(ТекСтрока.КорСубконто3) = Тип("СправочникСсылка.НоменклатурныеГруппы") Тогда
	//	СубконтоНоменклатурнаяГруппа = "КорСубконто3";
	//КонецЕсли;	
	
	СтруктураПоиска = Новый Структура("ТранспортноеСредство", ТекСтрока.КорСубконто3); //Отбор по ТС
	МассивОборотыПоТСиНоменклатурнымГруппам = тзОборотыПоТСиНоменклатурнымГруппам.НайтиСтроки(СтруктураПоиска);
	Если МассивОборотыПоТСиНоменклатурнымГруппам.Количество() = 0 Тогда //Распределять не на что, распределяем на все ТС и Ном. группы
		
		НоваяСтрока = ТаблицаРаспределения.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
	ИначеЕсли МассивОборотыПоТСиНоменклатурнымГруппам.Количество() = 1 Тогда //Одна строка, просто заполняем реквизиты
	
		НоваяСтрока = ТаблицаРаспределения.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока[СубконтоНоменклатурнаяГруппа] = МассивОборотыПоТСиНоменклатурнымГруппам[0].НоменклатурнаяГруппа;
		
	ИначеЕсли МассивОборотыПоТСиНоменклатурнымГруппам.Количество() > 1 Тогда //Работает распределение
	
		//Получение массива с коэффициентами для распределения суммы
		МассивКоэффициентов = Новый Массив;
		Для й=0 По МассивОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 
			МассивКоэффициентов.Добавить(МассивОборотыПоТСиНоменклатурнымГруппам[й].РабочееВремя);
		КонецЦикла; 
		
		//Подготовка к распределению сумм проводки по массиву коэффициентов
		СтруктураДляРаспределения 		= Новый Структура("Количество,Себестоимость,СуммаКорСписанияВР,СуммаКорСписанияНУ,СуммаКорСписанияПР,СуммаСписания,СуммаСписанияВР,СуммаСписанияНУ,СуммаСписанияПР", 0,0,0,0,0,0,0,0,0);
		СтруктураТочностьРаспределения 	= Новый Структура("Количество,Себестоимость,СуммаКорСписанияВР,СуммаКорСписанияНУ,СуммаКорСписанияПР,СуммаСписания,СуммаСписанияВР,СуммаСписанияНУ,СуммаСписанияПР", 3,2,2,2,2,2,2,2,2);
		ЗаполнитьЗначенияСвойств(СтруктураДляРаспределения, ТекСтрока);
			
		ТаблицаРаспределенныеСуммы = РаспределитьСуммуПоКолонкамТаблицыПропорциональноКоэффициентам(СтруктураДляРаспределения, СтруктураТочностьРаспределения, МассивКоэффициентов);  
			
		//Добавление новых строк в ТаблицаРаспределения     
		Для й=0 По МассивОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 

			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТаблицаРаспределенныеСуммы[й]);

			НоваяСтрока[СубконтоНоменклатурнаяГруппа] = МассивОборотыПоТСиНоменклатурнымГруппам[й].НоменклатурнаяГруппа;
			
		КонецЦикла; 

	КонецЕсли;	

КонецПроцедуры	

Процедура РаспределитьСписаниеТоваров(ТаблицаСписанныеМатериалы, Реквизиты) Экспорт
	
	//Получение таблицы оборотов по сотрудникам в разрезе ТС, ТиповТС и Номенклатурных групп   
	тзОборотыПоТСиНоменклатурнымГруппам = ПолучитьОборотыПоТСиНоменклатурнымГруппам(Реквизиты.Организация, Реквизиты.Период);
	
	//Пустая таблица для распределения строк
	ТаблицаРаспределения = ТаблицаСписанныеМатериалы.СкопироватьКолонки(); 
	
	//Обработка строк со счетом 25.03
	Счет_25_03 = ПланыСчетов.Хозрасчетный.ЭксплуатацияМаршрутныхАвтобусов;
	
	//Цикл по исходной таблице для получения таблицы с распределением
	Для Каждого ТекСтрока Из ТаблицаСписанныеМатериалы Цикл
		
		//Распределяются только строки счета затрат 25.03
		Если ТекСтрока.КорСчетСписания = Счет_25_03 Тогда 
			Если ЗначениеЗаполнено(ТекСтрока.КорСубконто3) Тогда
				РаспределитьСуммуСписанияТоваровПоНоменклатурнымГруппам(ТекСтрока, ТаблицаРаспределения, тзОборотыПоТСиНоменклатурнымГруппам, Счет_25_03);  
			Иначе
				НоваяСтрока = ТаблицаРаспределения.Добавить();	
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЕсли;	
		Иначе
			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;	
			
	КонецЦикла;	
	
	//Подмена исходной таблицы на таблицу с распределенными суммами
	ТаблицаСписанныеМатериалы = ТаблицаРаспределения.Скопировать();	
	
КонецПроцедуры	

//Распределяет сумму по всем ТС и Номенклатурным группам оборотов
Процедура РаспределитьСуммуЗарплатыНаВсеТСиНоменклатурныеГруппыПассажирскиеАвтобусы(ТекСтрока, ТаблицаРаспределения, тзОбщиеОборотыПоТипамТСиНоменклатурнымГруппам, СчетЗатрат, ПодразделениеАвтоколоннаПассажирскиеПеревозки);

	СтруктураПоиска = Новый Структура("Подразделение", ПодразделениеАвтоколоннаПассажирскиеПеревозки); //Отбор по подразделению затрат
	МассивОбщиеОборотыПоТСиНоменклатурнымГруппам = тзОбщиеОборотыПоТипамТСиНоменклатурнымГруппам.НайтиСтроки(СтруктураПоиска);
	Если МассивОбщиеОборотыПоТСиНоменклатурнымГруппам.Количество() = 0 Тогда // Нечего распределять
		НоваяСтрока = ТаблицаРаспределения.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	ИначеЕсли МассивОбщиеОборотыПоТСиНоменклатурнымГруппам.Количество() = 1 Тогда

		НоваяСтрока = ТаблицаРаспределения.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		Если НоваяСтрока.Счет = СчетЗатрат Тогда //Бывают проводки вида (БУ96.01.2,НУ20.01) - 70 (компенсация ежегодного отпуска), в которых не надо менять субконто в Дт. счета
			НоваяСтрока.Субконто1 = МассивОбщиеОборотыПоТСиНоменклатурнымГруппам[0].НоменклатурнаяГруппа; //20.01
		КонецЕсли;	
		
		Если НоваяСтрока.СчетНУ = СчетЗатрат Тогда //Заполнение СубконтоНУ2, СубконтоНУ3                     
			НоваяСтрока.СубконтоНУ1 = МассивОбщиеОборотыПоТСиНоменклатурнымГруппам[0].НоменклатурнаяГруппа; //20.01
		КонецЕсли;	
		
	ИначеЕсли МассивОбщиеОборотыПоТСиНоменклатурнымГруппам.Количество() > 1 Тогда
		
		//Получение массива с коэффициентами для распределения суммы
		МассивКоэффициентов = Новый Массив;
		Для й=0 По МассивОбщиеОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 
			МассивКоэффициентов.Добавить(МассивОбщиеОборотыПоТСиНоменклатурнымГруппам[й].РабочееВремя);
		КонецЦикла; 
		
		МассивРаспределенныхСумм = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ТекСтрока.Сумма, МассивКоэффициентов);

		Для й=0 По МассивОбщиеОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 

			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			
			Если НоваяСтрока.Счет = СчетЗатрат Тогда //Бывают проводки вида (БУ96.01.2,НУ20.01) - 70 (компенсация ежегодного отпуска), в которых не надо менять субконто в Дт. счета
				НоваяСтрока.Субконто1 = МассивОбщиеОборотыПоТСиНоменклатурнымГруппам[й].НоменклатурнаяГруппа; //20.01
			КонецЕсли;	
			
			Если НоваяСтрока.СчетНУ = СчетЗатрат Тогда //Заполнение СубконтоНУ2, СубконтоНУ3 
				НоваяСтрока.СубконтоНУ1 = МассивОбщиеОборотыПоТСиНоменклатурнымГруппам[й].НоменклатурнаяГруппа; //20.01
			КонецЕсли;	
			
			НоваяСтрока.Сумма = МассивРаспределенныхСумм[й];

		КонецЦикла; 
		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура РаспределитьСуммуЗарплатыПоТСиНоменклатурнымГруппамПассажирскиеАвтобусы(ТекСтрока, ТаблицаРаспределения, тзОборотыПоТСиНоменклатурнымГруппам, тзОбщиеОборотыПоПодразделениямТСиНоменклатурнымГруппам, СчетЗатрат, ПодразделениеАвтоколоннаПассажирскиеПеревозки)
	
	СтруктураПоиска = Новый Структура("Сотрудник, Подразделение", ТекСтрока.ФизическоеЛицо, ПодразделениеАвтоколоннаПассажирскиеПеревозки); //Отбор по сотруднику и подразделению затрат
	МассивОборотыПоТСиНоменклатурнымГруппам = тзОборотыПоТСиНоменклатурнымГруппам.НайтиСтроки(СтруктураПоиска);
	Если МассивОборотыПоТСиНоменклатурнымГруппам.Количество() = 0 Тогда //Распределять не на что, распределяем на все ТС и Ном. группы
		
		Если ТекСтрока.ВидОперации <> Перечисления.ВидыОперацийПоЗарплате.ДоговорРаботыУслуги Тогда
			Сообщить("20.01 Для сотрудника " + ТекСтрока.ФизическоеЛицо + " не указано ТС (маршрутный автобус!) по умолчанию!");
		КонецЕсли;	
		РаспределитьСуммуЗарплатыНаВсеТСиНоменклатурныеГруппыПассажирскиеАвтобусы(ТекСтрока, ТаблицаРаспределения, тзОбщиеОборотыПоПодразделениямТСиНоменклатурнымГруппам, СчетЗатрат, ПодразделениеАвтоколоннаПассажирскиеПеревозки);
		
	ИначеЕсли МассивОборотыПоТСиНоменклатурнымГруппам.Количество() = 1 Тогда //Одна строка, просто заполняем реквизиты
	
		НоваяСтрока = ТаблицаРаспределения.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		Если НоваяСтрока.Счет = СчетЗатрат Тогда //Бывают проводки вида (БУ96.01.2,НУ20.01) - 70 (компенсация ежегодного отпуска), в которых не надо менять субконто в Дт. счета
			НоваяСтрока.Субконто1 = МассивОборотыПоТСиНоменклатурнымГруппам[0].НоменклатурнаяГруппа; //Счет 20.01
		КонецЕсли;	

		Если НоваяСтрока.СчетНУ = СчетЗатрат Тогда //Заполнение СубконтоНУ2, СубконтоНУ3 
			НоваяСтрока.СубконтоНУ1 = МассивОборотыПоТСиНоменклатурнымГруппам[0].НоменклатурнаяГруппа; //20.01
		КонецЕсли;	
		
	ИначеЕсли МассивОборотыПоТСиНоменклатурнымГруппам.Количество() > 1 Тогда //Работает распределение
	
		//Получение массива с коэффициентами для распределения суммы
		МассивКоэффициентов = Новый Массив;
		Для й=0 По МассивОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 
			МассивКоэффициентов.Добавить(МассивОборотыПоТСиНоменклатурнымГруппам[й].РабочееВремя);
		КонецЦикла; 
		
		МассивРаспределенныхСумм = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ТекСтрока.Сумма, МассивКоэффициентов);

		Для й=0 По МассивОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 

			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			
			Если НоваяСтрока.Счет = СчетЗатрат Тогда //Бывают проводки вида (БУ96.01.2,НУ20.01) - 70 (компенсация ежегодного отпуска), в которых не надо менять субконто в Дт. счета
				НоваяСтрока.Субконто1 = МассивОборотыПоТСиНоменклатурнымГруппам[й].НоменклатурнаяГруппа; //20.01
			КонецЕсли;	
			
			Если НоваяСтрока.СчетНУ = СчетЗатрат Тогда //Заполнение СубконтоНУ2, СубконтоНУ3 
				НоваяСтрока.СубконтоНУ1 = МассивОборотыПоТСиНоменклатурнымГруппам[й].НоменклатурнаяГруппа; //Счет 20.01
			КонецЕсли;	
			
			НоваяСтрока.Сумма = МассивРаспределенныхСумм[й];

		КонецЦикла; 
		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура РаспределитьЗарплату(ТаблицаЗаработнойПлаты, Реквизиты) Экспорт
	
	//Получение таблицы оборотов по сотрудникам в разрезе ТС, ТиповТС и Номенклатурных групп
	тзОборотыПоСотрудникамТСиНоменклатурнымГруппам = ПолучитьОборотыПоСотрудникамТСиНоменклатурнымГруппам(Реквизиты.Организация, Реквизиты.Период);
	
	//Получение таблицы оборотов по Подразделениям, ТС и Номенклатурным группам
	тзОбщиеОборотыПоПодразделениямТСиНоменклатурнымГруппам = тзОборотыПоСотрудникамТСиНоменклатурнымГруппам.Скопировать();
	тзОбщиеОборотыПоПодразделениямТСиНоменклатурнымГруппам.Свернуть("СчетЗатрат,Подразделение,ТранспортноеСредство,НоменклатурнаяГруппа", "РабочееВремя");
	
	//Пустая таблица для распределения строк
	ТаблицаРаспределения = ТаблицаЗаработнойПлаты.СкопироватьКолонки(); 
	
	//Обработка строк со счетом 20.01, 25.02
	Счет_20_01 = ПланыСчетов.Хозрасчетный.ОсновноеПроизводство;
	Счет_25_02 = ПланыСчетов.Хозрасчетный.ЭксплуатацияДорожнойТехники;
	Счет_26	   = ПланыСчетов.Хозрасчетный.ОбщехозяйственныеРасходы;

	ПодразделениеАвтоколоннаПассажирскиеПеревозки = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПодразделениеАвтоколоннаПассажирскиеПеревозки", Реквизиты.Организация, Реквизиты.Период);
	
	СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете = ПолучитьСоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете();
	
	//Цикл по исходной таблице для получения таблицы с распределением
	Для Каждого ТекСтрока Из ТаблицаЗаработнойПлаты Цикл
		
		Если ТекСтрока.Счет = Счет_20_01 ИЛИ ТекСтрока.СчетНУ = Счет_20_01 Тогда
			
			Подразделение = СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете.Получить(ТекСтрока.СпособОтраженияЗарплатыВБухучете);
			ТекСтрока.Подразделение = ?(Подразделение=Неопределено, ТекСтрока.Подразделение, Подразделение);

			Если ТекСтрока.Подразделение = ПодразделениеАвтоколоннаПассажирскиеПеревозки Тогда
				РаспределитьСуммуЗарплатыПоТСиНоменклатурнымГруппамПассажирскиеАвтобусы(ТекСтрока, ТаблицаРаспределения, тзОборотыПоСотрудникамТСиНоменклатурнымГруппам, тзОбщиеОборотыПоПодразделениямТСиНоменклатурнымГруппам, Счет_20_01, ПодразделениеАвтоколоннаПассажирскиеПеревозки); 
			Иначе
				
				НоваяСтрока = ТаблицаРаспределения.Добавить();	
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				
			КонецЕсли;	
			
		ИначеЕсли ТекСтрока.Счет = Счет_25_02 ИЛИ ТекСтрока.СчетНУ = Счет_25_02 ИЛИ ТекСтрока.Счет = Счет_26 ИЛИ ТекСтрока.СчетНУ = Счет_26 Тогда //Подмена подразделения по способу отражения зарплаты в бухучете

			Подразделение = СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете.Получить(ТекСтрока.СпособОтраженияЗарплатыВБухучете);
			ТекСтрока.Подразделение = ?(Подразделение=Неопределено, ТекСтрока.Подразделение, Подразделение);

			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);

		Иначе
			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;	
			
	КонецЦикла;	
	
	//Подмена исходной таблицы на таблицу с распределенными суммами
	ТаблицаЗаработнойПлаты = ТаблицаРаспределения.Скопировать();	
	
КонецПроцедуры	

Функция ПолучитьСоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете()
	
	СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЮЦАУ_СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете.СпособОтраженияЗарплатыВБухУчете КАК СпособОтраженияЗарплатыВБухУчете,
		|	ЮЦАУ_СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете.Подразделение КАК Подразделение
		|ИЗ
		|	РегистрСведений.ЮЦАУ_СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете КАК ЮЦАУ_СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете.Вставить(ВыборкаДетальныеЗаписи.СпособОтраженияЗарплатыВБухУчете, ВыборкаДетальныеЗаписи.Подразделение);
	КонецЦикла;
	
	Возврат СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете; 
	
КонецФункции	

//Распределяет сумму по всем ТС и Номенклатурным группам оборотов
Процедура РаспределитьСуммуНачисленияРезерваНаВсеТСиНоменклатурныеГруппыПассажирскиеАвтобусы(ТекСтрока, ТаблицаРаспределения, тзОборотыПоТипамТСиНоменклатурнымГруппам, ПодразделениеАвтоколоннаПассажирскиеПеревозки);

	СтруктураПоиска = Новый Структура("Подразделение", ПодразделениеАвтоколоннаПассажирскиеПеревозки); //Отбор по подразделению затрат
	МассивОборотыПоТСиНоменклатурнымГруппам = тзОборотыПоТипамТСиНоменклатурнымГруппам.НайтиСтроки(СтруктураПоиска);
	Если МассивОборотыПоТСиНоменклатурнымГруппам.Количество() = 0 Тогда // Нечего распределять
		НоваяСтрока = ТаблицаРаспределения.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	ИначеЕсли МассивОборотыПоТСиНоменклатурнымГруппам.Количество() = 1 Тогда

		НоваяСтрока = ТаблицаРаспределения.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		НоваяСтрока.Субконто1 = МассивОборотыПоТСиНоменклатурнымГруппам[0].НоменклатурнаяГруппа; //20.01
		//НоваяСтрока.Субконто2 = МассивОборотыПоТСиНоменклатурнымГруппам[0].НоменклатурнаяГруппа;
		//НоваяСтрока.Субконто3 = МассивОборотыПоТСиНоменклатурнымГруппам[0].ТранспортноеСредство;
		
	ИначеЕсли МассивОборотыПоТСиНоменклатурнымГруппам.Количество() > 1 Тогда
		
		//Получение массива с коэффициентами для распределения суммы
		МассивКоэффициентов = Новый Массив;
		Для й=0 По МассивОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 
			МассивКоэффициентов.Добавить(МассивОборотыПоТСиНоменклатурнымГруппам[й].РабочееВремя);
		КонецЦикла; 
		
		//Подготовка к распределению сумм проводки по массиву коэффициентов
		СтруктураДляРаспределения 		= Новый Структура("Сумма,СуммаНУ", 0,0);
		СтруктураТочностьРаспределения 	= Новый Структура("Сумма,СуммаНУ", 2,2);
		ЗаполнитьЗначенияСвойств(СтруктураДляРаспределения, ТекСтрока);
			
		ТаблицаРаспределенныеСуммы = РаспределитьСуммуПоКолонкамТаблицыПропорциональноКоэффициентам(СтруктураДляРаспределения, СтруктураТочностьРаспределения, МассивКоэффициентов);  
		
		//Добавление новых строк в ТаблицаРаспределения     
		Для й=0 По МассивОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 

			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТаблицаРаспределенныеСуммы[й]);

			НоваяСтрока.Субконто1 = МассивОборотыПоТСиНоменклатурнымГруппам[й].НоменклатурнаяГруппа; //20.01
			//НоваяСтрока.Субконто2 = МассивОборотыПоТСиНоменклатурнымГруппам[й].НоменклатурнаяГруппа;
			//НоваяСтрока.Субконто3 = МассивОборотыПоТСиНоменклатурнымГруппам[й].ТранспортноеСредство;
			
		КонецЦикла; 

	КонецЕсли;	
	
КонецПроцедуры	

Процедура РаспределитьСуммуНачисленияРезерваПоТСиНоменклатурнымГруппамПассажирскиеАвтобусы(ТекСтрока, ТаблицаРаспределения, тзОборотыПоТСиНоменклатурнымГруппам, ПодразделениеАвтоколоннаПассажирскиеПеревозки)
	
	СтруктураПоиска = Новый Структура("ТранспортноеСредство", ТекСтрока.Субконто3); //Отбор по Транспортному средству
	МассивОборотыПоТСиНоменклатурнымГруппам = тзОборотыПоТСиНоменклатурнымГруппам.НайтиСтроки(СтруктураПоиска);
	Если МассивОборотыПоТСиНоменклатурнымГруппам.Количество() = 0 Тогда //Распределять не на что, распределяем на все ТС и Ном. группы
		
		РаспределитьСуммуНачисленияРезерваНаВсеТСиНоменклатурныеГруппыПассажирскиеАвтобусы(ТекСтрока, ТаблицаРаспределения, тзОборотыПоТСиНоменклатурнымГруппам, ПодразделениеАвтоколоннаПассажирскиеПеревозки);
		
	ИначеЕсли МассивОборотыПоТСиНоменклатурнымГруппам.Количество() = 1 Тогда //Одна строка, просто заполняем реквизиты
	
		НоваяСтрока = ТаблицаРаспределения.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		НоваяСтрока.Субконто1 = МассивОборотыПоТСиНоменклатурнымГруппам[0].НоменклатурнаяГруппа; //20.01
		//НоваяСтрока.Субконто2 = МассивОборотыПоТСиНоменклатурнымГруппам[0].НоменклатурнаяГруппа;
		//НоваяСтрока.Субконто3 = МассивОборотыПоТСиНоменклатурнымГруппам[0].ТранспортноеСредство;
		
	ИначеЕсли МассивОборотыПоТСиНоменклатурнымГруппам.Количество() > 1 Тогда //Работает распределение
	
		//Получение массива с коэффициентами для распределения суммы
		МассивКоэффициентов = Новый Массив;
		Для й=0 По МассивОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 
			МассивКоэффициентов.Добавить(МассивОборотыПоТСиНоменклатурнымГруппам[й].РабочееВремя);
		КонецЦикла; 
		
		МассивРаспределенныхСумм = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ТекСтрока.Сумма, МассивКоэффициентов);

		Для й=0 По МассивОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 

			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
			
			НоваяСтрока.Субконто1 = МассивОборотыПоТСиНоменклатурнымГруппам[й].НоменклатурнаяГруппа; //20.01
			//НоваяСтрока.Субконто2 = МассивОборотыПоТСиНоменклатурнымГруппам[й].НоменклатурнаяГруппа;
			//НоваяСтрока.Субконто3 = МассивОборотыПоТСиНоменклатурнымГруппам[й].ТранспортноеСредство;
			
			НоваяСтрока.Сумма = МассивРаспределенныхСумм[й];

		КонецЦикла; 
		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура РаспределитьНачислениеРезервов(ТаблицаРезервов, Реквизиты) Экспорт
	
	//Получение таблицы оборотов в разрезе ТС и Номенклатурных групп
	тзОборотыПоТСиНоменклатурнымГруппам = ПолучитьОборотыПоТСиНоменклатурнымГруппам(Реквизиты.Организация, Реквизиты.Период);
	
	//Пустая таблица для распределения строк
	ТаблицаРаспределения = ТаблицаРезервов.СкопироватьКолонки(); 
	
	//Обработка строк со счетом 20.01, 25.02
	Счет_20_01 = ПланыСчетов.Хозрасчетный.ОсновноеПроизводство;
	Счет_25_02 = ПланыСчетов.Хозрасчетный.ЭксплуатацияДорожнойТехники;
	Счет_26    = ПланыСчетов.Хозрасчетный.ОбщехозяйственныеРасходы;
	
	ПодразделениеАвтоколоннаПассажирскиеПеревозки = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПодразделениеАвтоколоннаПассажирскиеПеревозки", Реквизиты.Организация, Реквизиты.Период);

	СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете = ПолучитьСоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете();

	//Цикл по исходной таблице для получения таблицы с распределением
	Для Каждого ТекСтрока Из ТаблицаРезервов Цикл
		
		Если ТекСтрока.Счет = Счет_20_01 Тогда
			
			Подразделение = СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете.Получить(ТекСтрока.СпособОтраженияЗарплатыВБухучете);
			ТекСтрока.Подразделение = ?(Подразделение=Неопределено, ТекСтрока.Подразделение, Подразделение);
			
			Если ТекСтрока.Подразделение = ПодразделениеАвтоколоннаПассажирскиеПеревозки Тогда
				РаспределитьСуммуНачисленияРезерваПоТСиНоменклатурнымГруппамПассажирскиеАвтобусы(ТекСтрока, ТаблицаРаспределения, тзОборотыПоТСиНоменклатурнымГруппам, ПодразделениеАвтоколоннаПассажирскиеПеревозки); 
			Иначе	
				НоваяСтрока = ТаблицаРаспределения.Добавить();	
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЕсли;	

		ИначеЕсли ТекСтрока.Счет = Счет_25_02 ИЛИ ТекСтрока.Счет = Счет_26 Тогда //Подмена подразделения по способу отражения зарплаты в бухучете

			Подразделение = СоответствиеПодразделенияИСпособаОтраженияЗарплатыВБухУчете.Получить(ТекСтрока.СпособОтраженияЗарплатыВБухучете);
			ТекСтрока.Подразделение = ?(Подразделение=Неопределено, ТекСтрока.Подразделение, Подразделение);

			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			
		Иначе
			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;	
			
	КонецЦикла;	
	
	//Подмена исходной таблицы на таблицу с распределенными суммами
	ТаблицаРезервов = ТаблицаРаспределения.Скопировать();	
	
КонецПроцедуры	

// Выполняет пропорциональное распределение суммы в соответствии
// с заданными коэффициентами распределения по строке таблицы значений.
//
// Параметры:
//  РаспределяемаяСумма - Число  - сумма, которую надо распределить, если сумма равна 0 - то возвращается Неопределено;
//                                 Если передана отрицательная - расчет по модулю и после инверсия знаков результата.
//  Коэффициенты        - Массив - коэффициенты распределения, должны быть положительны или отрицательными одновременно
//  Точность            - Число  - точность округления при распределении. Необязателен.
//
// Возвращаемое значение:
//  Массив - массив размерностью равный массиву коэффициентов, содержит
//           суммы в соответствии с весом коэффициента (из массива коэффициентов).
//           В случае, если распределить невозможно (кол-во коэффициентов = 0
//           есть коэффициенты с отрицательным значением или суммарный вес коэффициентов = 0),
//           тогда будет возвращено Неопределено.
//
// Пример:
//
//	Коэффициенты = Новый Массив;
//	Коэффициенты.Добавить(1);
//	Коэффициенты.Добавить(2);
//	Результат = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(1, Коэффициенты);
//	// Результат = [0.33, 0.67]
//
Функция РаспределитьСуммуПоКолонкамТаблицыПропорциональноКоэффициентам(Знач СтруктураДляРаспределения, Знач СтруктураТочностьРаспределения, Знач Коэффициенты, Знач Точность=2) Экспорт
	
	ТаблицаРаспределения = Новый ТаблицаЗначений; 
	Для й=1 По Коэффициенты.Количество() Цикл
    	ТаблицаРаспределения.Добавить();
	КонецЦикла;
	
	Для Каждого ТекЭлемент Из СтруктураДляРаспределения Цикл
		
		ТаблицаРаспределения.Колонки.Добавить(ТекЭлемент.Ключ, Новый ОписаниеТипов("Число"));  

		Если ТекЭлемент.Значение <> 0 Тогда //Есть что распределять
			
			РазрядностьЗначения = СтруктураТочностьРаспределения[ТекЭлемент.Ключ];
			МассивРаспределенныхСумм = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(ТекЭлемент.Значение, Коэффициенты, РазрядностьЗначения);
			ТаблицаРаспределения.ЗагрузитьКолонку(МассивРаспределенныхСумм, ТекЭлемент.Ключ);

		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат ТаблицаРаспределения;
	
КонецФункции

Функция ОкруглитьЧерезСтроку(СуммаДляОкругления) Экспорт
	
	Запятая = Найти(Строка(СуммаДляОкругления),",");
	ЦелыеЧисла = Лев(Строка(СуммаДляОкругления),Запятая);
	Дробь = Прав(Строка(СуммаДляОкругления),СтрДлина(Строка(СуммаДляОкругления))-Запятая);
	
	Если СтрДлина(Дробь) >= 2 Тогда
		Дробь = Лев(Дробь,2);
	Иначе	   
		Дробь = Лев(Дробь + "00000000",2);
	КонецЕсли;	   
	
	фСумма = Число(ЦелыеЧисла+Дробь);
	
	Возврат(фСумма);
	
КонецФункции	

Функция ПолучитьДолжностьФизЛица(ФизическоеЛицо) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо,
	|	ТекущиеКадровыеДанныеСотрудников.Сотрудник,
	|	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущееПодразделение,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность,
	|	МАКСИМУМ(ТекущиеКадровыеДанныеСотрудников.ДатаПриема) КАК ДатаПриема,
	|	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения,
	|	ТекущиеКадровыеДанныеСотрудников.ОсновноеРабочееМестоВОрганизации,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущийВидЗанятости,
	|	ТекущиеКадровыеДанныеСотрудников.УдалитьТекущаяОрганизация
	|ИЗ
	|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
	|ГДЕ
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = &ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо,
	|	ТекущиеКадровыеДанныеСотрудников.Сотрудник,
	|	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущееПодразделение,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность,
	|	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения,
	|	ТекущиеКадровыеДанныеСотрудников.ОсновноеРабочееМестоВОрганизации,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущийВидЗанятости,
	|	ТекущиеКадровыеДанныеСотрудников.УдалитьТекущаяОрганизация
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПриема УБЫВ";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат Строка(ВыборкаДетальныеЗаписи.ТекущаяДолжность);
	Иначе
		Возврат Строка("");
	КонецЕсли;
	
КонецФункции	

Процедура ОткрытьФормуДопСведенийДоговора(Договор) Экспорт
	
	Форма = Договор.ПолучитьФорму("Справочник.ДоговорыКонтрагентов.Форма.ФормаДополнительнойИнформации");
	
	Форма.Договор = Договор;
	НаборЗаписей = РегистрыСведений.ЮЦАУ_ДоговорыКонтрагентовДопИнформация.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДоговорКонтрагента.Установить(Договор);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 1 Тогда
		
		Запись = НаборЗаписей[0];
		Форма.ЭлементыФормы.ПредметДоговора.Значение       = Запись.ПредметДоговора;
		Форма.ЭлементыФормы.ЦенаДоговора.Значение          = Запись.ЦенаДоговора;
		Форма.ЭлементыФормы.ПорядокРасчётов.Значение       = Запись.ПорядокРасчётов;
		Форма.ЭлементыФормы.ОтветственностьСторон.Значение = Запись.ОтветственностьСторон;
		Форма.ЭлементыФормы.СрокДействия.Значение          = Запись.СрокДействия;
		Форма.ЭлементыФормы.СсылкаНаСкан.Значение          = Запись.СсылкаНаСкан;
		
		Форма.ЭлементыФормы.ДатаРегистрации.Значение       = Запись.ДатаРегистрации;
		Форма.ЭлементыФормы.СрокИсполненияОрг.Значение     = Запись.СрокИсполненияОбязательствОрганизацией;
		Форма.ЭлементыФормы.СрокИсполненияКонтр.Значение   = Запись.СрокИсполненияОбязательствКонтрагентом;
		Форма.ЭлементыФормы.ОтметкиОбИсполнении.Значение   = Запись.ОтметкиОбИсполненииОбязательств;
		Форма.ЭлементыФормы.ПринятыеМеры.Значение          = Запись.ПринятыеМеры;
		
	КонецЕсли;
	
	Форма.Открыть();
	
КонецПроцедуры

Функция ОпределитьДеньНедели(НомерДняНедели) Экспорт
	
	Если НомерДняНедели = 1 Тогда
		Возврат "Понедельник";
	ИначеЕсли НомерДняНедели = 2 Тогда
		Возврат "Вторник";
	ИначеЕсли НомерДняНедели = 3 Тогда
		Возврат "Среда";
	ИначеЕсли НомерДняНедели = 4 Тогда
		Возврат "Четверг";
	ИначеЕсли НомерДняНедели = 5 Тогда
		Возврат "Пятница";
	ИначеЕсли НомерДняНедели = 6 Тогда
		Возврат "Суббота";
	Иначе
		Возврат "Воскресенье";
	КонецЕсли;
	
КонецФункции

