Процедура РаспределитьСуммуРБПпоНоменклатурнымГруппам(ТекСтрока, ТаблицаРаспределения, тзОборотыПоТСиНоменклатурнымГруппам)
	
	СтруктураПоиска = Новый Структура("ТранспортноеСредство", ТекСтрока.СубконтоЗатрат3); //Отбор по транспортному средству
	МассивОборотыПоТСиНоменклатурнымГруппам = тзОборотыПоТСиНоменклатурнымГруппам.НайтиСтроки(СтруктураПоиска);
	
	Если МассивОборотыПоТСиНоменклатурнымГруппам.Количество() = 0 Тогда //Распределять не на что, просто копируем строку
		НоваяСтрока = ТаблицаРаспределения.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	ИначеЕсли МассивОборотыПоТСиНоменклатурнымГруппам.Количество() = 1 Тогда //Одна строка, просто заполняем реквизиты
	
		НоваяСтрока = ТаблицаРаспределения.Добавить();	
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.СубконтоЗатрат2 = МассивОборотыПоТСиНоменклатурнымГруппам[0].НоменклатурнаяГруппа;
	
	ИначеЕсли МассивОборотыПоТСиНоменклатурнымГруппам.Количество() > 1 Тогда //Работает распределение
		
		//Получение массива с коэффициентами для распределения суммы
		МассивКоэффициентов = Новый Массив;
		Для й=0 По МассивОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 
			МассивКоэффициентов.Добавить(МассивОборотыПоТСиНоменклатурнымГруппам[й].РабочееВремя);
		КонецЦикла; 
		
		//Подготовка к распределению сумм проводки по массиву коэффициентов
		СтруктураДляРаспределения 		= Новый Структура("Сумма,СуммаВР,СуммаДоговора,СуммаНУ,СуммаПР", 0,0,0,0,0);
		СтруктураТочностьРаспределения 	= Новый Структура("Сумма,СуммаВР,СуммаДоговора,СуммаНУ,СуммаПР", 2,2,2,2,2);
		ЗаполнитьЗначенияСвойств(СтруктураДляРаспределения, ТекСтрока);
			
		ТаблицаРаспределенныеСуммы = РаспределитьСуммуПоКолонкамТаблицыПропорциональноКоэффициентам(СтруктураДляРаспределения, СтруктураТочностьРаспределения, МассивКоэффициентов);  
		
		//Добавление новых строк в ТаблицаРаспределения     
		Для й=0 По МассивОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 

			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТаблицаРаспределенныеСуммы[й]);

			НоваяСтрока.СубконтоЗатрат2 = МассивОборотыПоТСиНоменклатурнымГруппам[й].НоменклатурнаяГруппа;
			
		КонецЦикла; 

	КонецЕсли;	
	
КонецПроцедуры	

Функция РаспределитьРасходыБудущихПериодов(РасчетСписанияРБП, ТаблицаРеквизиты) Экспорт
	
	Реквизиты = ТаблицаРеквизиты[0];
	
 	//Получение таблицы оборотов по сотрудникам в разрезе ТС, ТиповТС и Номенклатурных групп   
	тзОборотыПоТСиНоменклатурнымГруппам = ПолучитьОборотыПоТСиНоменклатурнымГруппам(Реквизиты.Организация, Реквизиты.Период);

	//Пустая таблица для распределения строк
	ТаблицаРаспределения = РасчетСписанияРБП.СкопироватьКолонки(); 
	
	//Обработка строк со счетом 25.03
	Счет_25_03 = ПланыСчетов.Хозрасчетный.ЭксплуатацияМаршрутныхАвтобусов;
	
	//Цикл по исходной таблице для получения таблицы с распределением
	Для Каждого ТекСтрока Из РасчетСписанияРБП Цикл
		
		//Распределяются только строки счета затрат 25.03
		Если ТекСтрока.СчетСписания = Счет_25_03 И ЗначениеЗаполнено(ТекСтрока.СубконтоЗатрат3) Тогда 	//Распределяем на номенклатурные группы по Транспортному средству		
			РаспределитьСуммуРБПпоНоменклатурнымГруппам(ТекСтрока, ТаблицаРаспределения, тзОборотыПоТСиНоменклатурнымГруппам); 	
		Иначе 
			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;	
			
	КонецЦикла;	
	
	Возврат ТаблицаРаспределения;	
	
КонецФункции

Функция ПолучитьОборотыПоСотрудникамТСиНоменклатурнымГруппам(Организация, ДатаПериода)
	
	//Получение таблицы оборотов по сотрудникам в разрезе ТС, Подразделений и Номенклатурных групп
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЮЦАУ_ОсновныеТССотрудниковСрезПоследних.СчетЗатрат КАК СчетЗатрат,
		|	ЮЦАУ_ОсновныеТССотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
		|	ЮЦАУ_ОсновныеТССотрудниковСрезПоследних.Подразделение КАК Подразделение,
		|	ЮЦАУ_ОсновныеТССотрудниковСрезПоследних.ТранспортноеСредство КАК ТранспортноеСредство
		|ПОМЕСТИТЬ ВТ_ОсновныеТССотрудников
		|ИЗ
		|	РегистрСведений.ЮЦАУ_ОсновныеТССотрудников.СрезПоследних(&ОкончаниеПериода, ) КАК ЮЦАУ_ОсновныеТССотрудниковСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЮЦАУ_ОсновныеМаршрутыТССрезПоследних.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ЮЦАУ_ОсновныеМаршрутыТССрезПоследних.Подразделение КАК Подразделение,
		|	ЮЦАУ_ОсновныеМаршрутыТССрезПоследних.Маршрут КАК Маршрут
		|ПОМЕСТИТЬ ВТ_ОсновныеМаршрутыТС
		|ИЗ
		|	РегистрСведений.ЮЦАУ_ОсновныеМаршрутыТС.СрезПоследних(&ОкончаниеПериода, ) КАК ЮЦАУ_ОсновныеМаршрутыТССрезПоследних
		|;
