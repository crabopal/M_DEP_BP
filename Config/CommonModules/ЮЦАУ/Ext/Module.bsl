			нЗапись.Регистратор = Источник;
			нЗапись.ТС = Стр.ТС;
			нЗапись.Номенклатура = Стр.Номенклатура;
			нЗапись.Количество = Стр.Количество;
			нЗапись.ДатаУстановки = Источник.Дата;//?(ЗначениеЗаполнено(Стр.ДатаУстановки), Стр.ДатаУстановки, Источник.ДатаОкончания);
		КонецЦикла;
		
		нзРНТС.Записать();
	КонецЕсли;
	
	нзЗЧ = РегистрыНакопления.уатНоменклатураТС.СоздатьНаборЗаписей();
	нзЗЧ.Отбор.Регистратор.Установить(ДокументСсылка);
	нзЗЧ.Прочитать();
	
	Если  нзЗЧ.Количество() > 0 Тогда 
		// Подготовим таблицу, по которой отберем остатки
		ОтборОстатков = Новый ТаблицаЗначений();
		ОтборОстатков.Колонки.Добавить("СчетУчета",    Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
