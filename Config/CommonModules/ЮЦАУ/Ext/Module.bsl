		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОсновныеТССотрудников.СчетЗатрат КАК СчетЗатрат,
		|	ВТ_ОсновныеТССотрудников.Сотрудник КАК Сотрудник,
		|	ВТ_ОсновныеТССотрудников.Подразделение КАК Подразделение,
		|	ВТ_ОсновныеТССотрудников.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ВЗ_ОсновныеМаршрутыТС.Маршрут КАК Маршрут
		|ПОМЕСТИТЬ ВТ_МаршрутыСотрудники
		|ИЗ
		|	ВТ_ОсновныеТССотрудников КАК ВТ_ОсновныеТССотрудников
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_ОсновныеМаршрутыТС.Подразделение КАК Подразделение,
		|			ВТ_ОсновныеМаршрутыТС.ТранспортноеСредство КАК ТранспортноеСредство,
		|			ВТ_ОсновныеМаршрутыТС.Маршрут КАК Маршрут
		|		ИЗ
		|			ВТ_ОсновныеМаршрутыТС КАК ВТ_ОсновныеМаршрутыТС) КАК ВЗ_ОсновныеМаршрутыТС
		|		ПО ВТ_ОсновныеТССотрудников.ТранспортноеСредство = ВЗ_ОсновныеМаршрутыТС.ТранспортноеСредство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_МаршрутыСотрудники.Сотрудник КАК Сотрудник,
		|	ВТ_МаршрутыСотрудники.Подразделение КАК Подразделение,
		|	ВТ_МаршрутыСотрудники.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ВЗ_МаршрутыНоменклатурнойГруппы.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
		|	0 КАК РабочееВремя
		|ИЗ
		|	ВТ_МаршрутыСотрудники КАК ВТ_МаршрутыСотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_МаршрутыНоменклатурнойГруппы.Маршрут КАК Маршрут,
		|			ВТ_МаршрутыНоменклатурнойГруппы.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа
		|		ИЗ
		|			ВТ_МаршрутыНоменклатурнойГруппы КАК ВТ_МаршрутыНоменклатурнойГруппы) КАК ВЗ_МаршрутыНоменклатурнойГруппы
		|		ПО ВТ_МаршрутыСотрудники.Маршрут = ВЗ_МаршрутыНоменклатурнойГруппы.Маршрут
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Сотрудник КАК Сотрудник,
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.СчетЗатрат КАК СчетЗатрат,
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Подразделение КАК Подразделение,
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
		|	СУММА(ЮЦАУ_ОборотыПоМаршрутамОбороты.РабочееВремяОборот) КАК РабочееВремя
		|ИЗ
		|	РегистрНакопления.ЮЦАУ_ОборотыПоМаршрутам.Обороты(&НачалоПериода, &ОкончаниеПериода, Запись, ) КАК ЮЦАУ_ОборотыПоМаршрутамОбороты
		|ГДЕ
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Организация = &Организация
		|
		|СГРУППИРОВАТЬ ПО
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Сотрудник,
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.СчетЗатрат,
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Подразделение,
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.ТранспортноеСредство,
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.НоменклатурнаяГруппа
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сотрудник,
		|	НоменклатурнаяГруппа,
		|	Подразделение,
		|	ТранспортноеСредство
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ДатаПериода));
	
	Граница = Новый Граница(КонецМесяца(ДатаПериода), ВидГраницы.Включая);
    Запрос.УстановитьПараметр("ОкончаниеПериода", Граница); 
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаУмолчаний = МассивРезультатов[4].Выгрузить();
	ТаблицаИтоговая = МассивРезультатов[5].Выгрузить();
	
	// +++ 1 бит Балицкий В.В.
	ЗаполнитьПустуюНоменклатурнуюГруппуПоОсновномуМаршруту(ТаблицаУмолчаний, Организация, ДатаПериода, ТаблицаУмолчаний);
	ЗаполнитьПустуюНоменклатурнуюГруппуПоОсновномуМаршруту(ТаблицаИтоговая, Организация, ДатаПериода, ТаблицаУмолчаний);
	// --- 1 бит Балицкий В.В.
	
	//Проверка необходимости добавления строк с умолчаниями (с нулевыми коэффициентами)
	Для Каждого ТекСтрока Из ТаблицаУмолчаний Цикл

		// +++ 1 бит Балицкий В.В.
		// НайденнаяСтрока = ТаблицаИтоговая.Найти(ТекСтрока.Сотрудник, "Сотрудник"); 		
		// Если НайденнаяСтрока = Неопределено Тогда
		НайденныеСтроки = ТаблицаИтоговая.НайтиСтроки(Новый Структура("Сотрудник, Подразделение", ТекСтрока.Сотрудник, ТекСтрока.Подразделение));
		Если НайденныеСтроки.Количество() = 0 Тогда
		// --- 1 бит Балицкий В.В.
			НоваяСтрока = ТаблицаИтоговая.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;	
		
	КонецЦикла;	
	
	// +++ 1 бит Балицкий В.В.
	ЗаполнитьПустуюНоменклатурнуюГруппуПоОсновномуМаршруту(ТаблицаИтоговая, Организация, ДатаПериода, ТаблицаУмолчаний);
	// --- 1 бит Балицкий В.В.
	
	Возврат ТаблицаИтоговая;  

КонецФункции	

// +++ 1 бит Балицкий В.В.
Процедура ЗаполнитьПустуюНоменклатурнуюГруппуПоОсновномуМаршруту(ТаблицаОборотов, Организация, ДатаПериода, ТаблицаУмолчаний = Неопределено)
	
	Если ТаблицаОборотов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Маршрут_Перегон = ПолучитьЗначениеПоИдентификатору("Маршрут_Перегон", Организация, ДатаПериода);
	Маршрут_Резерв = ПолучитьЗначениеПоИдентификатору("Маршрут_Резерв", Организация, ДатаПериода);
	Маршрут_ПеревозкаЛюдейПоГороду = ПолучитьЗначениеПоИдентификатору("Маршрут_ПеревозкаЛюдейПоГороду", Организация, ДатаПериода);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЮЦАУ_ОсновныеМаршрутыТССрезПоследних.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ЮЦАУ_ОсновныеМаршрутыТССрезПоследних.Маршрут КАК Маршрут
		|ИЗ
		|	РегистрСведений.ЮЦАУ_ОсновныеМаршрутыТС.СрезПоследних(&ДатаПериода, ) КАК ЮЦАУ_ОсновныеМаршрутыТССрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТранспортноеСредство,
		|	Маршрут
		|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("ДатаПериода", КонецМесяца(ДатаПериода));
	тзСоответствиеТСиМаршрута = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЮЦАУ_СоответствиеМаршрутаИНоменклатурнойГруппыСрезПоследних.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
		|	ЮЦАУ_СоответствиеМаршрутаИНоменклатурнойГруппыСрезПоследних.Маршрут КАК Маршрут
		|ИЗ
		|	РегистрСведений.ЮЦАУ_СоответствиеМаршрутаИНоменклатурнойГруппы.СрезПоследних(&ДатаПериода, ) КАК ЮЦАУ_СоответствиеМаршрутаИНоменклатурнойГруппыСрезПоследних";
	Запрос.УстановитьПараметр("ДатаПериода", КонецМесяца(ДатаПериода));
	тзСоответствиеМаршрутаИНоменклатурнойГруппы = Запрос.Выполнить().Выгрузить();
	
	ЕстьКолонкаМаршрут = ТаблицаОборотов.Колонки.Найти("Маршрут") <> Неопределено;
	
	Для Каждого СтрокаОборотов Из ТаблицаОборотов Цикл
		
		Если ЗначениеЗаполнено(СтрокаОборотов.НоменклатурнаяГруппа) Тогда
			Продолжить;
		КонецЕсли;
		
		ТСДляНГ = СтрокаОборотов.ТранспортноеСредство;
		Если ТаблицаУмолчаний <> Неопределено Тогда
			СтрокаУмолчания = ТаблицаУмолчаний.Найти(СтрокаОборотов.Сотрудник, "Сотрудник");
			Если СтрокаУмолчания <> Неопределено Тогда
				Если ЗначениеЗаполнено(СтрокаУмолчания.НоменклатурнаяГруппа) Тогда
					СтрокаОборотов.НоменклатурнаяГруппа = СтрокаУмолчания.НоменклатурнаяГруппа;
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаУмолчания.ТранспортноеСредство) Тогда
					ТСДляНГ = СтрокаУмолчания.ТранспортноеСредство;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		МаршрутДляНГ = Неопределено;
		Если ЕстьКолонкаМаршрут Тогда
			МаршрутДляНГ = СтрокаОборотов.Маршрут;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(МаршрутДляНГ)
			ИЛИ МаршрутДляНГ = Маршрут_Перегон
			ИЛИ МаршрутДляНГ = Маршрут_Резерв
			ИЛИ МаршрутДляНГ = Маршрут_ПеревозкаЛюдейПоГороду Тогда
			
			НайденнаяСтрокаТС = тзСоответствиеТСиМаршрута.Найти(ТСДляНГ, "ТранспортноеСредство");
			Если НайденнаяСтрокаТС <> Неопределено Тогда
				МаршрутДляНГ = НайденнаяСтрокаТС.Маршрут;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(МаршрутДляНГ) Тогда
			НайденнаяСтрокаНГ = тзСоответствиеМаршрутаИНоменклатурнойГруппы.Найти(МаршрутДляНГ, "Маршрут");
			Если НайденнаяСтрокаНГ <> Неопределено Тогда
				СтрокаОборотов.НоменклатурнаяГруппа = НайденнаяСтрокаНГ.НоменклатурнаяГруппа;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
