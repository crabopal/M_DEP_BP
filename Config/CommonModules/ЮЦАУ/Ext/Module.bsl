Функция ПолучитьЗначениеПоИдентификатору(Идентификатор,Организация = Неопределено,ДатаСреза = '00010101000000') Экспорт
	
	Если Организация = Неопределено Тогда
		Организация = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияПоУмолчанию_ЮЦАУСрезПоследних.Период,
	|	ЗначенияПоУмолчанию_ЮЦАУСрезПоследних.Идентификатор,
	|	ЗначенияПоУмолчанию_ЮЦАУСрезПоследних.Значение,
	|	ЗначенияПоУмолчанию_ЮЦАУСрезПоследних.Организация
	|ИЗ
	|	РегистрСведений.ЗначенияПоУмолчанию_ЮЦАУ.СрезПоследних(
	|			&ДатаСреза,
	|			Идентификатор = &Идентификатор
	|				И Организация = &Организация) КАК ЗначенияПоУмолчанию_ЮЦАУСрезПоследних";
	
	Запрос.УстановитьПараметр("Идентификатор",Идентификатор);
	Запрос.УстановитьПараметр("ДатаСреза",ДатаСреза);
	
	Если Организация <> Справочники.Организации.ПустаяСсылка() Тогда
		Запрос.УстановитьПараметр("Организация",Организация);
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И Организация = &Организация","");
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат(Результат.Значение);
	КонецЕсли;
	
КонецФункции	

Процедура ОбработатьТребованиеНакладная(Документ)
	
	ПроводкиДокумента = Документ.Движения.Хозрасчетный.Выгрузить();
	
	Записывать = Ложь;
	
	Для Каждого Стр Из ПроводкиДокумента Цикл
		
		Если Стр.СчетКт.ПринадлежитЭлементу(ПланыСчетов.Хозрасчетный.Материалы) Тогда
			
			Проводка = Документ.Движения.Хозрасчетный.Добавить();
			Проводка.Организация = Документ.Организация;
			Проводка.Содержание  = "Оприходовано ТМЦ (ДЭП)";
			Проводка.Период = Документ.Дата;
			
			Проводка.СчетДт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("013");
			Проводка.СубконтоДт.Номенклатура = Стр.СубконтоКт2;
			Проводка.СубконтоДт.Склады = Стр.СубконтоКт3;
			Проводка.КоличествоДт = Стр.КоличествоКт;
			Проводка.Сумма = Стр.Сумма;
			
			Записывать = Истина;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если Записывать Тогда
		Попытка
			Документ.Движения.Хозрасчетный.Записать();
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры	

Процедура ПередачаОС(Источник)
	
	СтруктураШапкиДокумента = Источник.Ссылка;
	
	Записывать = Ложь;
	
	нзБУ = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
	нзБУ.Отбор.Регистратор.Установить(Источник.Ссылка);
	нзБУ.Прочитать();
	
	Если СтруктураШапкиДокумента.ПередачаВДепартамент Тогда
		
		ПроводкиДокумента =   Источник.Движения.Хозрасчетный.Выгрузить();
		СодержаниеПроводки = "Передача ОС";
		
		Для Каждого Стр Из ПроводкиДокумента Цикл
			
			Если  Стр.СчетКт = ПланыСчетов.Хозрасчетный.ПрочиеДоходы И  Стр.СчетДт = ПланыСчетов.Хозрасчетный.РасчетыПоВкладамВУставныйКапитал Тогда
				
				//Проводка Дт84.07 Кт75.01 				
				Проводка = нзБУ.Добавить();
				Проводка.Период       = СтруктураШапкиДокумента.Дата;
				Проводка.Активность   = Истина;
				Проводка.Организация  = СтруктураШапкиДокумента.Организация;
				Проводка.Содержание   = СодержаниеПроводки;
				Проводка.Сумма        = Стр.Сумма;
				
				Проводка.СчетДт       = ПланыСчетов.Хозрасчетный.ИмуществоСверхУставногоКапитала;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт,Проводка.СубконтоДт,"НаправленияИспользованияПрибыли", СтруктураШапкиДокумента.НаправленияИспользованияПрибыли);				
				Проводка.СчетКт       = ПланыСчетов.Хозрасчетный.РасчетыПоВкладамВУставныйКапитал;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт,Проводка.СубконтоКт,"Контрагенты", СтруктураШапкиДокумента.Контрагент);
				
				//Если СтруктураШапкиДокумента.ОтражатьВНалоговомУчете Тогда
				//	НалоговыйУчет.ЗаполнитьНалоговыеСуммыПроводки(СуммаПроводкиНУ,СуммаПроводкиНУ,СуммаПроводкиПР,СуммаПроводкиПР,СуммаПроводкиВР,СуммаПроводкиВР,Проводка, СтруктураШапкиДокумента.ПрименениеПБУ18);
				//КонецЕсли;
				Записывать = Истина;
			КонецЕсли;	
		КонецЦикла;	
		
	КонецЕсли;	 
	
	Если Записывать Тогда
		нзБУ.ОбменДанными.Загрузка = Истина;
		нзБУ.Записать();
	КонецЕсли;
	
КонецПроцедуры	

