Функция ВремяВходитВИнтервал(пДатаВыезда,пДатаВозвращения,пНачалоОбеда,пКонецОбеда)
	
	пВремяОбеда = 0;
	
	Если  КонецДня(пДатаВыезда) < КонецДня(пДатаВозвращения) Тогда //Несколько  дней
		
		Пока пДатаВыезда < пДатаВозвращения Цикл
			
			КонецДня = Мин(КонецДня(пДатаВыезда),пДатаВозвращения);
			
			Если пДатаВыезда < Дата(Год(пДатаВыезда),Месяц(пДатаВыезда),День(пДатаВыезда),Час(пНачалоОбеда),Минута(пНачалоОбеда),Секунда(пНачалоОбеда)) И 
				КонецДня > Дата(Год(КонецДня),Месяц(КонецДня),День(КонецДня),Час(пКонецОбеда),Минута(пКонецОбеда),Секунда(пКонецОбеда)) Тогда 
				пВремяОбеда = пВремяОбеда + (пКонецОбеда-пНачалоОбеда);
			КонецЕсли;
			
			пДатаВыезда = КонецДня + 1;
			
		КонецЦикла;
		
		Возврат(пВремяОбеда);
		
	Иначе
		
		КонецДня = Мин(КонецДня(пДатаВыезда),пДатаВозвращения);
		
		Если пДатаВыезда < Дата(Год(пДатаВыезда),Месяц(пДатаВыезда),День(пДатаВыезда),Час(пНачалоОбеда),Минута(пНачалоОбеда),Секунда(пНачалоОбеда)) И 
			КонецДня > Дата(Год(КонецДня),Месяц(КонецДня),День(КонецДня),Час(пКонецОбеда),Минута(пКонецОбеда),Секунда(пКонецОбеда)) Тогда 
			пВремяОбеда = пВремяОбеда + (пКонецОбеда-пНачалоОбеда);
		КонецЕсли;
		
		Возврат(пВремяОбеда);
		
	КонецЕсли;	
	
	Возврат(0);
	
КонецФункции	


Функция ПолучитьДолжностьСотрудникаУАТ(Сотрудник,Организация,КонПериода) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	уатСведенияОСотрудникахСрезПоследних.Должность КАК Должность
	|ИЗ
	|	РегистрСведений.уатСведенияОСотрудниках.СрезПоследних(
	|			&КонПериода,
	|			Сотрудник = &Сотрудник
	|				И Организация = &Организация) КАК уатСведенияОСотрудникахСрезПоследних";
	
	Запрос.УстановитьПараметр("КонПериода", КонПериода);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если  РезультатЗапроса.Следующий() Тогда
		Возврат(РезультатЗапроса.Должность);
	Иначе	
		Возврат(Неопределено);
	КонецЕсли;
	
КонецФункции

Функция ПроверитьВидОбслуживанияТСсОсобымПорядкомУчета(ВидОбслуживанияТС) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыОбслуживанияТСсОсобымПорядкомУчета.ВидОбслуживания
	|ИЗ
	|	РегистрСведений.ВидыОбслуживанияТСсОсобымПорядкомУчета КАК ВидыОбслуживанияТСсОсобымПорядкомУчета
	|ГДЕ
	|	ВидыОбслуживанияТСсОсобымПорядкомУчета.ВидОбслуживания = &ВидОбслуживанияТС";
	
	Запрос.УстановитьПараметр("ВидОбслуживанияТС",ВидОбслуживанияТС);
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат(Истина);
	Иначе
		Возврат(Ложь);
	КонецЕсли;
	
КонецФункции	

Процедура уатСписаниеТоваров(Источник)
	
	ДокументСсылка = Источник.Ссылка;
	
	ОтборОстатков = Новый ТаблицаЗначений();
	ОтборОстатков.Колонки.Добавить("СчетУчета",    Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
	ОтборОстатков.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ОтборОстатков.Колонки.Добавить("Склад",        Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ОтборОстатков.Колонки.Добавить("Контрагент",   Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	
	ТаблицаЗЧ = Источник.Товары.Выгрузить();
	
	Для Каждого СтрНЗ Из ТаблицаЗЧ Цикл
		нСтр = ОтборОстатков.Добавить();
		СведенияОНоменклатуре = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(ДокументСсылка.Организация, СтрНЗ.Номенклатура, ДокументСсылка.Склад, ДокументСсылка.Дата, Ложь);
		нСтр.СчетУчета = СведенияОНоменклатуре.СчетУчета;
		//нСтр.СчетУчета = ПланыСЧетов.Хозрасчетный.ЗапасныеЧасти;
		нСтр.Номенклатура = СтрНЗ.Номенклатура;
		нСтр.Склад = ДокументСсылка.Склад;
	КонецЦикла;
	
	
	нзСтоимостьЗЧ = РегистрыНакопления.ЮЦАУ_СтоимостьСписанияЗЧ.СоздатьНаборЗаписей();
	нзСтоимостьЗЧ.Отбор.Регистратор.Установить(ДокументСсылка);
	нзСтоимостьЗЧ.Прочитать();
	
	ТаблицаОстаткиСтоимость = УчетТоваров.ПолучитьОстаткиТоваров(
	ДокументСсылка.МоментВремени(),
	ДокументСсылка.Организация,
	Справочники.ПодразделенияОрганизаций.ПустаяСсылка(),
	ОтборОстатков);
	ТаблицаОстаткиСтоимость.Свернуть("Номенклатура", "КоличествоПоСкладу, Стоимость");
	
	Для Каждого Стр Из ТаблицаЗЧ Цикл
		
		нЗапись = нзСтоимостьЗЧ.Добавить();
		нЗапись.Период = Источник.Дата;
		нЗапись.Регистратор = Источник;
		нЗапись.Склад = Источник.Склад;
		нЗапись.Номенклатура = Стр.Номенклатура;
		нЗапись.Количество = Стр.Количество;
		нЗапись.Стоимость = ?(ТаблицаОстаткиСтоимость.Найти(Стр.Номенклатура) <> Неопределено, Стр.Количество * (ТаблицаОстаткиСтоимость.Найти(Стр.Номенклатура).Стоимость / ТаблицаОстаткиСтоимость.Найти(Стр.Номенклатура).КоличествоПоСкладу), 0);	
		
	КонецЦикла;
	
	нзСтоимостьЗЧ.Записать();
	
КонецПроцедуры	

Процедура ОтражениеЗарплатыВБухучете(Источник)
	
