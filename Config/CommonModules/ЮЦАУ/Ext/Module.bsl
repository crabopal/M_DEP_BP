		ОтборОстатков.Колонки.Добавить("Контрагент",   Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		
		Для Каждого СтрНЗ Из нзЗЧ Цикл
			нСтр = ОтборОстатков.Добавить();
			СведенияОНоменклатуре = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(ДокументСсылка.Организация, СтрНЗ.Номенклатура, ДокументСсылка.Склад, ДокументСсылка.Дата, Ложь);
			нСтр.СчетУчета = СведенияОНоменклатуре.СчетУчета;
			//нСтр.СчетУчета = ПланыСЧетов.Хозрасчетный.ЗапасныеЧасти;
			нСтр.Номенклатура = СтрНЗ.Номенклатура;
			нСтр.Склад = ДокументСсылка.Склад;
		КонецЦикла;
		
		ТаблицаОстатки = УчетТоваров.ПолучитьОстаткиТоваров(
		ДокументСсылка.МоментВремени(),
		ДокументСсылка.Организация,
		Справочники.ПодразделенияОрганизаций.ПустаяСсылка(),
		ОтборОстатков);
		
		Для Каждого СтрТО Из ТаблицаОстатки Цикл
			//Если нзЗЧ[СтрТО.НомерСтроки-1].Количество > СтрТО.КоличествоПоСкладу Тогда
			//	СообщениеОбОшибке = "Некорректно заполнена колонка ""Количество"" списка ""Материалы"" по " + СокрЛП(Строка(СтрТО.Номенклатура.Наименование))+ " ("+ СокрЛП(Строка(СтрТО.Номенклатура.Код))+ "). Указанное количество превышает остаток. Остаток:" + Строка(СтрТО.КоличествоПоСкладу) + " ; Не хватает: "+ Строка(нзЗЧ[СтрТО.НомерСтроки-1].Количество - СтрТО.КоличествоПоСкладу);
			//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке);
			//КонецЕсли;		
		КонецЦикла;	
		
	КонецЕсли;
	
	нзСтоимостьЗЧ = РегистрыНакопления.ЮЦАУ_СтоимостьСписанияЗЧ.СоздатьНаборЗаписей();
	нзСтоимостьЗЧ.Отбор.Регистратор.Установить(ДокументСсылка);
	нзСтоимостьЗЧ.Прочитать();
	
	ТаблицаЗЧ = Источник.Материалы.Выгрузить();
	
	Для Каждого Стр Из ТаблицаЗЧ Цикл
		
		ОтборОстатков = Новый ТаблицаЗначений();
		ОтборОстатков.Колонки.Добавить("СчетУчета",    Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
		ОтборОстатков.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ОтборОстатков.Колонки.Добавить("Склад",        Новый ОписаниеТипов("СправочникСсылка.Склады"));
		ОтборОстатков.Колонки.Добавить("Контрагент",   Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		
		ДатаОстатков = КонецДня(ДокументСсылка.Дата);
		пМоментВремени = Новый МоментВремени(ДатаОстатков, ДокументСсылка.Ссылка);    
		
		нСтр = ОтборОстатков.Добавить();
		СведенияОНоменклатуре = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(ДокументСсылка.Организация, Стр.Номенклатура, ДокументСсылка.Склад, ДокументСсылка.Дата, Ложь);
		нСтр.СчетУчета = СведенияОНоменклатуре.СчетУчета;
		нСтр.Номенклатура = Стр.Номенклатура;
		нСтр.Склад = ДокументСсылка.Склад;

		ТаблицаОстаткиСтоимость = УчетТоваров.ПолучитьОстаткиТоваров(
		пМоментВремени,
		ДокументСсылка.Организация,
		Справочники.ПодразделенияОрганизаций.ПустаяСсылка(),
		ОтборОстатков);
		ТаблицаОстаткиСтоимость.Свернуть("Номенклатура", "КоличествоПоСкладу, Стоимость");
		
		нЗапись = нзСтоимостьЗЧ.Добавить();
		нЗапись.Период = Источник.Дата;
		нЗапись.Регистратор = Источник;
		нЗапись.Склад = Источник.Склад;
		нЗапись.Номенклатура = Стр.Номенклатура;
		нЗапись.Количество = Стр.Количество;
		нЗапись.Стоимость = ?(ТаблицаОстаткиСтоимость.Найти(Стр.Номенклатура) <> Неопределено, Стр.Количество * (ТаблицаОстаткиСтоимость.Найти(Стр.Номенклатура).Стоимость / ТаблицаОстаткиСтоимость.Найти(Стр.Номенклатура).КоличествоПоСкладу), 0);	
		
	КонецЦикла;
	
	нзСтоимостьЗЧ.Записать();
	
КонецПроцедуры	

