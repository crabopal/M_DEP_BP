		Для й=0 По МассивОборотыПоТСиНоменклатурнымГруппам.ВГраница() Цикл 

			НоваяСтрока = ТаблицаРаспределения.Добавить();	
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.Субконто2 = МассивОборотыПоТСиНоменклатурнымГруппам[й].НоменклатурнаяГруппа;
			
			НоваяСтрока.Сумма = МассивРаспределенныхСумм[й];

		КонецЦикла; 

	КонецЕсли;	
	
КонецПроцедуры	

