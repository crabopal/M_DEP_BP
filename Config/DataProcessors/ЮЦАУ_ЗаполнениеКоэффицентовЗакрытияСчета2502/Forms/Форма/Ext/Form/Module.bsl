//&НаКлиентеНаСервереБезКонтекста
&НаСервере
Процедура УправлениеФормойНаСервере()

	//Зачистка отбора по дате
	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Список.Отбор, "Дата");
	
	//Установка отбора по дате
	ОтборыСписковКлиентСервер.УстановитьЭлементОтбораСписка(Список, "Дата", КонецМесяца(Объект.ДатаПериода), ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	ОтборыСписковКлиентСервер.УстановитьЭлементОтбораСписка(Список, "Дата", НачалоМесяца(Объект.ДатаПериода), ВидСравненияКомпоновкиДанных.БольшеИлиРавно);

КонецПроцедуры	


&НаСервере
Функция СуществуютДокументыНастройкаЗакрытияСчета25_02(Организация, ДатаНач, ДатаКон)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЮЦАУ_НастройкаЗакрытияСчета25_02.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЮЦАУ_НастройкаЗакрытияСчета25_02 КАК ЮЦАУ_НастройкаЗакрытияСчета25_02
		|ГДЕ
		|	ЮЦАУ_НастройкаЗакрытияСчета25_02.Дата МЕЖДУ &ДатаНач И &ДатаКон
		|	И ЮЦАУ_НастройкаЗакрытияСчета25_02.Организация = &Организация";
	
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаКон", КонецДня(ДатаКон));
	Запрос.УстановитьПараметр("ДатаНач", НачалоДня(ДатаНач));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Количество() > 0 Тогда
		Возврат Истина;
	Иначе	           
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции


&НаСервере
Процедура ЗаполнитьДокументыНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.КатегорияТС.ПодразделениеЗатрат КАК ПодразделениеКт25,
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
		|	ЮЦАУ_ОборотыПоМаршрутамОбороты.РабочееВремяОборот КАК РабочееВремя
		|ИЗ
		|	РегистрНакопления.ЮЦАУ_ОборотыПоМаршрутам.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Период,
		|			Организация = &Организация
		|				И СчетЗатрат = &СчетЗатрат) КАК ЮЦАУ_ОборотыПоМаршрутамОбороты
		|ИТОГИ
		|	СУММА(РабочееВремяОборот)
		|ПО
		|	ОБЩИЕ,
		|	ПодразделениеКт25,
		|	НоменклатурнаяГруппа";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.ДатаПериода));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.ДатаПериода));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("СчетЗатрат", ПланыСчетов.Хозрасчетный.ЭксплуатацияДорожнойТехники);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВыборкаОбщийИтог.Следующий();		// Общий итог
	ВыборкаПодразделениеКт25 = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПодразделениеКт25.Следующий() Цикл
		
		ДокОбъект = ПолучитьДокументНастройкаЗакрытияСчета25_02(Объект.Организация, Объект.ДатаПериода, Объект.ПодразделениеДт20, ВыборкаПодразделениеКт25.ПодразделениеКт25);
		ДокОбъект.НастройкаЗакрытия.Очистить();
		
		МассивКоэффициентов = Новый Массив;
		
		ВыборкаНоменклатурнаяГруппа = ВыборкаПодразделениеКт25.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаНоменклатурнаяГруппа.Следующий() Цикл
			НоваяСтрока = ДокОбъект.НастройкаЗакрытия.Добавить();
			НоваяСтрока.НоменклатурнаяГруппа = ВыборкаНоменклатурнаяГруппа.НоменклатурнаяГруппа; 
			
			МассивКоэффициентов.Добавить(ВыборкаНоменклатурнаяГруппа.РабочееВремя);
			
		КонецЦикла;

		МассивРаспределенныхСумм = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(100, МассивКоэффициентов, 3);		
		
		//Добавление коэффициентов в таблицу документа
		Для Каждого ТекСтрока Из ДокОбъект.НастройкаЗакрытия Цикл
			ТекСтрока.Коэффициент = МассивРаспределенныхСумм[ТекСтрока.НомерСтроки-1];
		КонецЦикла;	
		
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		
	КонецЦикла;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументы(Команда)  
	
	Если СуществуютДокументыНастройкаЗакрытияСчета25_02(Объект.Организация, НачалоМесяца(Объект.ДатаПериода), КонецМесяца(Объект.ДатаПериода)) Тогда
		
		ТекстВопроса = НСтр("ru = 'Существующие документы будут перезаполнены. Продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ВопросПередФормированиемДокументовЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
			НСтр("ru = 'Формирование документов'"));
	
	Иначе	
		ЗаполнитьДокументыНаСервере();
	КонецЕсли;	
КонецПроцедуры


&НаКлиенте
Процедура ВопросПередФормированиемДокументовЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументыНаСервере();
	КонецЕсли;
	
КонецПроцедуры


Функция ПолучитьДокументНастройкаЗакрытияСчета25_02(Организация, ДатаПериода, ПодразделениеДт20, ПодразделениеКт25)  
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЮЦАУ_НастройкаЗакрытияСчета25_02.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЮЦАУ_НастройкаЗакрытияСчета25_02 КАК ЮЦАУ_НастройкаЗакрытияСчета25_02
		|ГДЕ
		|	ЮЦАУ_НастройкаЗакрытияСчета25_02.Организация = &Организация
		|	И ЮЦАУ_НастройкаЗакрытияСчета25_02.ПодразделениеДт20 = &ПодразделениеДт20
		|	И ЮЦАУ_НастройкаЗакрытияСчета25_02.ПодразделениеКт25 = &ПодразделениеКт25
		|	И НАЧАЛОПЕРИОДА(ЮЦАУ_НастройкаЗакрытияСчета25_02.Дата, День) = &Дата";
	
	Запрос.УстановитьПараметр("Дата", НачалоДня(КонецМесяца(ДатаПериода)));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПодразделениеДт20", ПодразделениеДт20);
	Запрос.УстановитьПараметр("ПодразделениеКт25", ПодразделениеКт25);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	КонецЦикла;
	
	ДокОбъект = Документы.ЮЦАУ_НастройкаЗакрытияСчета25_02.СоздатьДокумент();
	
	ДокОбъект.Дата = КонецМесяца(ДатаПериода);
	ДокОбъект.Организация = Организация;
	ДокОбъект.ПодразделениеДт20 = ПодразделениеДт20;
	ДокОбъект.ПодразделениеКт25 = ПодразделениеКт25;

	Возврат ДокОбъект;
	
КонецФункции	