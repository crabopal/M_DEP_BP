&НаСервере
Процедура ЗаполнитьТаблицуДвиженияТМЦНаСервере()
	
	ТаблицаДокументыТМЦ.Очистить();
	
	ЗагрузитьДокументыТМЦУАТНаСервере();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЮЦАУ_СкладыУАТ.Склад КАК Склад
		|ПОМЕСТИТЬ ВТ_СкладыУАТ
		|ИЗ
		|	РегистрСведений.ЮЦАУ_СкладыУАТ КАК ЮЦАУ_СкладыУАТ
		|ГДЕ
		|	ЮЦАУ_СкладыУАТ.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПоступлениеТоваровУслуг.Ссылка) КАК ГУИД,
		|	ПоступлениеТоваровУслуг.Ссылка КАК Документ,
		|	ПоступлениеТоваровУслуг.Склад КАК Склад,
		|	NULL КАК СкладПолучатель,
		|	ПоступлениеТоваровУслуг.ПодразделениеОрганизации КАК Подразделение
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Организация = &Организация
		|	И ПоступлениеТоваровУслуг.Склад В
		|			(ВЫБРАТЬ
		|				ВТ_СкладыУАТ.Склад
		|			ИЗ
		|				ВТ_СкладыУАТ КАК ВТ_СкладыУАТ)
		|	И НАЧАЛОПЕРИОДА(ПоступлениеТоваровУслуг.Дата, МЕСЯЦ) = &ДатаПериода
		|	И ПоступлениеТоваровУслуг.Проведен = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ОприходованиеТоваров.Ссылка),
		|	ОприходованиеТоваров.Ссылка,
		|	ОприходованиеТоваров.Склад,
		|	NULL,
		|	ОприходованиеТоваров.ПодразделениеОрганизации
		|ИЗ
		|	Документ.ОприходованиеТоваров КАК ОприходованиеТоваров
		|ГДЕ
		|	ОприходованиеТоваров.Организация = &Организация
		|	И ОприходованиеТоваров.Склад В
		|			(ВЫБРАТЬ
		|				ВТ_СкладыУАТ.Склад
		|			ИЗ
		|				ВТ_СкладыУАТ КАК ВТ_СкладыУАТ)
		|	И НАЧАЛОПЕРИОДА(ОприходованиеТоваров.Дата, МЕСЯЦ) = &ДатаПериода
		|	И ОприходованиеТоваров.Проведен = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(АвансовыйОтчетТовары.Ссылка),
		|	АвансовыйОтчетТовары.Ссылка,
		|	АвансовыйОтчетТовары.Ссылка.Склад,
		|	NULL,
		|	АвансовыйОтчетТовары.Ссылка.ПодразделениеОрганизации
		|ИЗ
		|	Документ.АвансовыйОтчет.Товары КАК АвансовыйОтчетТовары
		|ГДЕ
		|	АвансовыйОтчетТовары.Ссылка.Организация = &Организация
		|	И АвансовыйОтчетТовары.Ссылка.Склад В
		|			(ВЫБРАТЬ
		|				ВТ_СкладыУАТ.Склад
		|			ИЗ
		|				ВТ_СкладыУАТ КАК ВТ_СкладыУАТ)
		|	И НАЧАЛОПЕРИОДА(АвансовыйОтчетТовары.Ссылка.Дата, МЕСЯЦ) = &ДатаПериода
		|	И АвансовыйОтчетТовары.Ссылка.Проведен = ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	АвансовыйОтчетТовары.Ссылка,
		|	АвансовыйОтчетТовары.Ссылка.Склад,
		|	АвансовыйОтчетТовары.Ссылка.ПодразделениеОрганизации
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПеремещениеТоваров.Ссылка),
		|	ПеремещениеТоваров.Ссылка,
		|	ПеремещениеТоваров.СкладОтправитель,
		|	ПеремещениеТоваров.СкладПолучатель,
		|	ПеремещениеТоваров.ПодразделениеОтправитель
		|ИЗ
		|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
		|ГДЕ
		|	(ПеремещениеТоваров.Организация = &Организация
		|				И НАЧАЛОПЕРИОДА(ПеремещениеТоваров.Дата, МЕСЯЦ) = &ДатаПериода
		|				И ПеремещениеТоваров.СкладОтправитель В
		|					(ВЫБРАТЬ
		|						ВТ_СкладыУАТ.Склад
		|					ИЗ
		|						ВТ_СкладыУАТ КАК ВТ_СкладыУАТ)
		|			ИЛИ ПеремещениеТоваров.СкладПолучатель В
		|				(ВЫБРАТЬ
		|					ВТ_СкладыУАТ.Склад
		|				ИЗ
		|					ВТ_СкладыУАТ КАК ВТ_СкладыУАТ))
		|	И НАЧАЛОПЕРИОДА(ПеремещениеТоваров.Дата, МЕСЯЦ) = &ДатаПериода
		|	И ПеремещениеТоваров.Проведен = ИСТИНА
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ИнвентаризацияТоваровНаСкладе.Ссылка),
		|	ИнвентаризацияТоваровНаСкладе.Ссылка,
		|	ИнвентаризацияТоваровНаСкладе.Склад,
		|	NULL,
		|	NULL
		//|	ИнвентаризацияТоваровНаСкладе.ПодразделениеОрганизации
		|ИЗ
		|	Документ.ИнвентаризацияТоваровНаСкладе КАК ИнвентаризацияТоваровНаСкладе
		|ГДЕ
		|	ИнвентаризацияТоваровНаСкладе.Организация = &Организация
		|	И ИнвентаризацияТоваровНаСкладе.Склад В
		|			(ВЫБРАТЬ
		|				ВТ_СкладыУАТ.Склад
		|			ИЗ
		|				ВТ_СкладыУАТ КАК ВТ_СкладыУАТ)
		|	И НАЧАЛОПЕРИОДА(ИнвентаризацияТоваровНаСкладе.Дата, МЕСЯЦ) = &ДатаПериода
		|	И ИнвентаризацияТоваровНаСкладе.Проведен = ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	Документ
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ДатаПериода", НачалоМесяца(Объект.ДатаПериода));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаДокументыТМЦ.Загрузить(РезультатЗапроса.Выгрузить());
	
	//Запрос для связи с таблицей ДокументыУАТ по ГУИД
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДокументыУАТ.ГУИД КАК ГУИД,
		|	ТаблицаДокументыУАТ.ДокументУАТ КАК ДокументУАТ,
		|	ТаблицаДокументыУАТ.ДокументУАТПроведен КАК ДокументУАТПроведен
		|ПОМЕСТИТЬ ВТ_ДокументыУАТ
		|ИЗ
		|	&ТаблицаДокументыУАТ КАК ТаблицаДокументыУАТ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаДокументы.ГУИД КАК ГУИД,
		|	ТаблицаДокументы.Документ КАК Документ,
		|	ТаблицаДокументы.Склад КАК Склад,
		|	ТаблицаДокументы.СкладПолучатель КАК СкладПолучатель,
		|	ТаблицаДокументы.Подразделение КАК Подразделение
		|ПОМЕСТИТЬ ВТ_Документы
		|ИЗ
		|	&ТаблицаДокументы КАК ТаблицаДокументы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Документы.Документ КАК Документ,
		|	ВТ_Документы.Склад КАК Склад,
		|	ВТ_Документы.СкладПолучатель КАК СкладПолучатель,
		|	ВТ_Документы.Подразделение КАК Подразделение,
		|	ВЗ_ДокументыУАТ.ДокументУАТ КАК ДокументУАТ,
		|	ВЗ_ДокументыУАТ.ДокументУАТПроведен КАК ДокументУАТПроведен
		|ИЗ
		|	ВТ_Документы КАК ВТ_Документы
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_ДокументыУАТ.ГУИД КАК ГУИД,
		|			ВТ_ДокументыУАТ.ДокументУАТ КАК ДокументУАТ,
		|			ВТ_ДокументыУАТ.ДокументУАТПроведен КАК ДокументУАТПроведен
		|		ИЗ
		|			ВТ_ДокументыУАТ КАК ВТ_ДокументыУАТ) КАК ВЗ_ДокументыУАТ
		|		ПО ВТ_Документы.ГУИД = ВЗ_ДокументыУАТ.ГУИД
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументУАТПроведен,
		|	Документ
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ТаблицаДокументыУАТ", ТаблицаДокументыТМЦУАТ.Выгрузить());
	Запрос.УстановитьПараметр("ТаблицаДокументы", ТаблицаДокументыТМЦ.Выгрузить());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаДокументыТМЦ.Загрузить(РезультатЗапроса.Выгрузить());

КонецПроцедуры

