	Запрос.УстановитьПараметр("тзСписаниеМатериалов", тзСписаниеМатериалов);
	Запрос.УстановитьПараметр("ПодразделениеЗатрат", ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	ВыборкаОбщийИтог.Следующий(); 

	ВыборкаПоСкладу = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаПоСкладу.Следующий() Цикл 

		Если Не ЗначениеЗаполнено(ВыборкаПоСкладу.Склад) Тогда
			Продолжить;
		КонецЕсли;	
		
		ВыборкаПоСчетуЗатрат = ВыборкаПоСкладу.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		Пока ВыборкаПоСчетуЗатрат.Следующий() Цикл 
		
