Функция ПолучитьСтруктураТипЦен(ТипЦен)
	
	ГУИД = ТипЦен.УникальныйИдентификатор();
	
	СтруктураОбъекта = Новый Структура();
	СтруктураОбъекта.Вставить("Тип", "Справочник.ТипыЦенНоменклатуры");
	СтруктураОбъекта.Вставить("Идентификатор", ГУИД);
	СтруктураОбъекта.Вставить("Код", ТипЦен.Код);
