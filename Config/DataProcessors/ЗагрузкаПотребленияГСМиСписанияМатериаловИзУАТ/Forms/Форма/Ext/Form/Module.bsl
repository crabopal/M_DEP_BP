Функция ПолучитьТранспортноеСредство(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.ТранспортныеСредства.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		Если СтруктураОбъекта.ЭтоГруппа Тогда
			//ОбъектКакОбъект = Справочники.ТранспортныеСредства.СоздатьГруппу();   
			//ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование; 
		Иначе   

			ОбъектКакОбъект = Справочники.ТранспортныеСредства.СоздатьЭлемент();
			ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование; 
			ОбъектКакОбъект.РегистрационныйЗнак = СтруктураОбъекта.ГосударственныйНомер;  
			
			ОбъектКакОбъект.Модель = ПолучитьМодель(СтруктураОбъекта.Модель);
			ОбъектКакОбъект.ТипТС = ПолучитьТипТС(СтруктураОбъекта.ТипТС);

		КонецЕсли;

		//Если СтруктураОбъекта.Свойство("Родитель") Тогда 
		//	ОбъектКакОбъект.Родитель = ПолучитьТранспортноеСредство(СтруктураОбъекта.Родитель);	
		//КонецЕсли;	
		
		ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					
		ОбъектКакОбъект.Записать();
		
		Возврат ОбъектКакОбъект.Ссылка;	
		
	Иначе
		Возврат СсылкаВИБ; 
	КонецЕсли;
	
КонецФункции	

