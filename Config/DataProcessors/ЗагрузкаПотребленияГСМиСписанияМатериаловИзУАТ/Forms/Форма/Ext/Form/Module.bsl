&НаСервере
Функция ПолучитьПодразделение(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.ПодразделенияОрганизаций.ПолучитьСсылку(УИДСсылки);
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		//Попытка поиска подразделения по идентификатору
		ПодразделениеСсылка = ПолучитьОбъектПоИдентификатору(СтруктураОбъекта.Идентификатор);
		Если ПодразделениеСсылка <> Неопределено Тогда   
			Возврат ПодразделениеСсылка;
		КонецЕсли;	
		
		Сообщить("Не найдено подразделение: " + СтруктураОбъекта.Идентификатор + " Код: " + СтруктураОбъекта.Код + "  " + СтруктураОбъекта.Наименование);
		Возврат Неопределено; 
		
	Иначе     

		Если СтруктураОбъекта.Код <> СсылкаВИБ.Код Тогда
			Сообщить("Отличается код для подразделения: " + СтруктураОбъекта.Идентификатор + " " + СтруктураОбъекта.Код + " СсылкаВИБ.Код: " + СсылкаВИБ.Код);
		КонецЕсли;	
		
		Если СтруктураОбъекта.Наименование <> СсылкаВИБ.Наименование Тогда
			Сообщить("Отличается наименование для подразделения: " + СтруктураОбъекта.Идентификатор + " " + СтруктураОбъекта.Наименование + " СсылкаВИБ.Наименование: " + СсылкаВИБ.Наименование);
		КонецЕсли;	

		Возврат СсылкаВИБ; 
		
	КонецЕсли;
	
КонецФункции		

// Функция для десериализации в JSON
&НаСервере
Функция ПолучитьСтруктуруИзJSON(СтрокаJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	СтруктураИзJSON = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Возврат СтруктураИзJSON;
	
КонецФункции	

&НаСервере
Процедура ДесериализоватьJSON_ПотреблениеТоплива(СтрокаJSON)
	
	СоздаватьОбъекты = Истина;
	
	МассивПолейДат = Новый Массив;
	МассивПолейДат.Добавить("Период");
	МассивПолейДат.Добавить("ДатаПериода");
	МассивПолейДат.Добавить("ФизлицоДатаРождения");
	СписокСтрок = ДесериализоватьJSON(СтрокаJSON, МассивПолейДат);	
	
	ТаблицаПотреблениеТоплива.Очистить();

	Для Каждого СтруктураСтроки Из СписокСтрок.ДанныеПотреблениеТоплива Цикл
		
		Склад = Неопределено;
		ТранспортноеСредство = Неопределено;
		Номенклатура = Неопределено;
		Подразделение = Неопределено;

		Если СтруктураСтроки.Свойство("ТранспортноеСредство") Тогда
			ТранспортноеСредство = ПолучитьТранспортноеСредство(СтруктураСтроки.ТранспортноеСредство);
		КонецЕсли;	
		
		Если СтруктураСтроки.Свойство("Номенклатура") Тогда                                 
			Номенклатура = ПолучитьНоменклатуру(СтруктураСтроки.Номенклатура);
		КонецЕсли;	

		Если СтруктураСтроки.Свойство("Подразделение") Тогда                                 
			Подразделение = ПолучитьПодразделение(СтруктураСтроки.Подразделение);
		КонецЕсли;	

		НоваяСтрока = ТаблицаПотреблениеТоплива.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
		НоваяСтрока.ТранспортноеСредство = ТранспортноеСредство;
		НоваяСтрока.ПодразделениеЗатрат = Подразделение;
		НоваяСтрока.Номенклатура = Номенклатура;    
			
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тзАналогиНоменклатуры.Склад КАК Склад,
		|	тзАналогиНоменклатуры.Номенклатура КАК Номенклатура,
		|	тзАналогиНоменклатуры.АналогНоменклатуры КАК АналогНоменклатуры
		|ПОМЕСТИТЬ ВТ_АналогиНоменклатуры
		|ИЗ
		|	&тзАналогиНоменклатуры КАК тзАналогиНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тзПотреблениеТоплива.ТранспортноеСредство КАК ТранспортноеСредство,
		|	тзПотреблениеТоплива.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	тзПотреблениеТоплива.Номенклатура КАК Номенклатура,
		|	тзПотреблениеТоплива.РасходПоФакту КАК РасходПоФакту
		|ПОМЕСТИТЬ ВТ_ПотреблениеТоплива
		|ИЗ
		|	&тзПотреблениеТоплива КАК тзПотреблениеТоплива
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПотреблениеТоплива.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ВТ_ПотреблениеТоплива.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	ВТ_ПотреблениеТоплива.Номенклатура КАК Номенклатура,
		|	ВТ_ПотреблениеТоплива.РасходПоФакту КАК РасходПоФакту,
		|	ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СкладТопливо КАК Склад,
		|	ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СчетЗатрат КАК СчетЗатрат,
		|	ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СчетУчетаГСМ КАК СчетУчетаГСМ
		|ПОМЕСТИТЬ ВТ_ПотреблениеТопливаИтог
		|ИЗ
		|	ВТ_ПотреблениеТоплива КАК ВТ_ПотреблениеТоплива
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.Подразделение КАК Подразделение,
		|			ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СкладТопливо КАК СкладТопливо,
		|			ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СчетЗатрат КАК СчетЗатрат,
		|			ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СчетУчетаГСМ КАК СчетУчетаГСМ
		|		ИЗ
		|			РегистрСведений.ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТ.СрезПоследних(&ДатаПериода, ) КАК ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних) КАК ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних
		|		ПО ВТ_ПотреблениеТоплива.ПодразделениеЗатрат = ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.Подразделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПотреблениеТопливаИтог.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ВТ_ПотреблениеТопливаИтог.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	ВТ_ПотреблениеТопливаИтог.РасходПоФакту КАК РасходПоФакту,
		|	ВТ_ПотреблениеТопливаИтог.Склад КАК Склад,
		|	ВТ_ПотреблениеТопливаИтог.СчетЗатрат КАК СчетЗатрат,
		|	ВТ_ПотреблениеТопливаИтог.СчетУчетаГСМ КАК СчетУчетаГСМ,
		|	ЕСТЬNULL(ВЗ_АналогиНоменклатуры.АналогНоменклатуры, ВТ_ПотреблениеТопливаИтог.Номенклатура) КАК Номенклатура
		|ИЗ
		|	ВТ_ПотреблениеТопливаИтог КАК ВТ_ПотреблениеТопливаИтог
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_АналогиНоменклатуры.Склад КАК Склад,
		|			ВТ_АналогиНоменклатуры.Номенклатура КАК Номенклатура,
		|			ВТ_АналогиНоменклатуры.АналогНоменклатуры КАК АналогНоменклатуры
		|		ИЗ
		|			ВТ_АналогиНоменклатуры КАК ВТ_АналогиНоменклатуры) КАК ВЗ_АналогиНоменклатуры
		|		ПО ВТ_ПотреблениеТопливаИтог.Склад = ВЗ_АналогиНоменклатуры.Склад
		|			И ВТ_ПотреблениеТопливаИтог.Номенклатура = ВЗ_АналогиНоменклатуры.Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Склад,
		|	ПодразделениеЗатрат,
		|	ТранспортноеСредство
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	тзПотреблениеТоплива = ТаблицаПотреблениеТоплива.Выгрузить();
	тзАналогиНоменклатуры = ТаблицаАналогиНоменклатуры.Выгрузить();
	
	Запрос.УстановитьПараметр("тзПотреблениеТоплива", тзПотреблениеТоплива);
	Запрос.УстановитьПараметр("тзАналогиНоменклатуры", тзАналогиНоменклатуры);
	Запрос.УстановитьПараметр("ДатаПериода", КонецМесяца(Объект.ДатаПериода));
	
	РезультатЗапроса = Запрос.Выполнить();
	
    ТаблицаПотреблениеТоплива.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

