	ОбъектУжеВыгружен = ПроверитьЧтоОбъектУжеВыгружен(ГУИД);
	Если ОбъектУжеВыгружен Тогда //Достаточно ссылки, не надо перебирать реквизиты
		Возврат СтруктураОбъекта;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Подразделение.Родитель) Тогда
		СтруктураОбъекта.Вставить("Родитель", ПолучитьСтруктуруПодразделение(Подразделение.Родитель));
	КонецЕсли;	 
	
	Если ЗначениеЗаполнено(Подразделение.РегистрацияВНалоговомОргане) Тогда
		СтруктураОбъекта.Вставить("КПП", Подразделение.РегистрацияВНалоговомОргане.КПП);
		СтруктураОбъекта.Вставить("КодПоОКАТО", Подразделение.РегистрацияВНалоговомОргане.КодПоОКАТО);
	КонецЕсли;
	
	Возврат СтруктураОбъекта;

КонецФункции

&НаСервере
Функция ПроверитьЧтоОбъектУжеВыгружен(ГУИД)
	
	ЭлементСписка = СписокВыгруженныхОбъектов.НайтиПоЗначению(ГУИД);
	Если ЭлементСписка = Неопределено Тогда 
		СписокВыгруженныхОбъектов.Добавить(ГУИД); 
		Возврат Ложь;
	Иначе	
		Возврат Истина;
	КонецЕсли;
	
КонецФункции	

&НаСервере
Функция ПолучитьСтруктуруКонтрагент(Контрагент)

	ГУИД = Контрагент.УникальныйИдентификатор();
	
	СтруктураОбъекта = Новый Структура();
	СтруктураОбъекта.Вставить("Тип", "Справочник.Контрагенты");
	СтруктураОбъекта.Вставить("Идентификатор", ГУИД);
	СтруктураОбъекта.Вставить("Код", Контрагент.Код);
	СтруктураОбъекта.Вставить("Наименование", Контрагент.Наименование);
	СтруктураОбъекта.Вставить("ЭтоГруппа", Контрагент.ЭтоГруппа);
	
	ОбъектУжеВыгружен = ПроверитьЧтоОбъектУжеВыгружен(ГУИД);
	Если ОбъектУжеВыгружен Тогда //Достаточно ссылки, не надо перебирать реквизиты
		Возврат СтруктураОбъекта;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Контрагент.Родитель) Тогда
		СтруктураОбъекта.Вставить("Родитель", ПолучитьСтруктуруКонтрагент(Контрагент.Родитель));
	КонецЕсли;	 
	
	Если Не Контрагент.ЭтоГруппа Тогда
		
		СтруктураОбъекта.Вставить("НаименованиеПолное", Контрагент.НаименованиеПолное);
		СтруктураОбъекта.Вставить("Комментарий", Контрагент.Комментарий);
		СтруктураОбъекта.Вставить("ИНН", Контрагент.ИНН);
		СтруктураОбъекта.Вставить("КПП", Контрагент.КПП);
		СтруктураОбъекта.Вставить("КодПоОКПО", Контрагент.КодПоОКПО);
		СтруктураОбъекта.Вставить("ДополнительноеОписание", Контрагент.ДополнительнаяИнформация);
		СтруктураОбъекта.Вставить("ЮридическоеФизическоеЛицо", Строка(Контрагент.ЮридическоеФизическоеЛицо));
		СтруктураОбъекта.Вставить("НалоговыйНомер", Строка(Контрагент.НалоговыйНомер));
		СтруктураОбъекта.Вставить("СтранаРегистрации", ПолучитьСтруктуруСтранаМира(Контрагент.СтранаРегистрации));

		СтруктураОбъекта.Вставить("ГоловнойКонтрагент", ПолучитьСтруктуруКонтрагент(Контрагент.ГоловнойКонтрагент));
		
	КонецЕсли;
	
	Возврат СтруктураОбъекта;

КонецФункции

