Функция ПолучитьСтруктуруСклад(Склад)
	
	ГУИД = Склад.УникальныйИдентификатор();
	
	СтруктураОбъекта = Новый Структура();
	СтруктураОбъекта.Вставить("Тип", "Справочник.Склады");
	СтруктураОбъекта.Вставить("Идентификатор", ГУИД);
	СтруктураОбъекта.Вставить("Код", Склад.Код);
	СтруктураОбъекта.Вставить("Наименование", Склад.Наименование);
	СтруктураОбъекта.Вставить("ЭтоГруппа", Склад.ЭтоГруппа);

	ОбъектУжеВыгружен = ПроверитьЧтоОбъектУжеВыгружен(ГУИД);
	Если ОбъектУжеВыгружен Тогда //Достаточно ссылки, не надо перебирать реквизиты
		Возврат СтруктураОбъекта;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Склад.Родитель) Тогда
		СтруктураОбъекта.Вставить("Родитель", ПолучитьСтруктуруСклад(Склад.Родитель));
	КонецЕсли;	
	
	Если Не Склад.ЭтоГруппа Тогда
		СтруктураОбъекта.Вставить("Комментарий", Склад.Комментарий);
		СтруктураОбъекта.Вставить("ТипСклада", Строка(Склад.ТипСклада));
	КонецЕсли;	
	
	Возврат СтруктураОбъекта;

