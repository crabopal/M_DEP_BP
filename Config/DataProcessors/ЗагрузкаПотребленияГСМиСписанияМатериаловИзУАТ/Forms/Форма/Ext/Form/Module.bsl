			Пока ВыборкаПоПодразделениюЗатрат.Следующий() Цикл 
		
				ВыборкаПоТранспортномуСредству = ВыборкаПоПодразделениюЗатрат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
				Пока ВыборкаПоТранспортномуСредству.Следующий() Цикл 

					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("Организация", Объект.Организация);
					СтруктураПараметров.Вставить("ДатаПериода", Объект.ДатаПериода);
					СтруктураПараметров.Вставить("Склад", ВыборкаПоСкладу.Склад);
					СтруктураПараметров.Вставить("СчетЗатрат", ВыборкаПоСчетуЗатрат.СчетЗатрат);
					СтруктураПараметров.Вставить("СтатьяЗатрат", СтатьяЗатратСтоимостьЗапчастей);
					СтруктураПараметров.Вставить("ПодразделениеЗатрат", ВыборкаПоПодразделениюЗатрат.ПодразделениеЗатрат);
					СтруктураПараметров.Вставить("ТранспортноеСредство", ВыборкаПоТранспортномуСредству.ТранспортноеСредство);
					СтруктураПараметров.Вставить("Комментарий", "#Списание материалов " + ВыборкаПоТранспортномуСредству.ТранспортноеСредство);
					СтруктураПараметров.Вставить("СчетаУчетаЗатратВТаблице", Ложь);

					СоздаватьДокумент = Ложь;
					ДокументТребованиеНакладная = ПолучитьДокументТребованиеНакладная(СтруктураПараметров, СоздаватьДокумент);		
					
					Если ДокументТребованиеНакладная <> Неопределено Тогда
						Возврат Истина;
					КонецЕсли;	

				КонецЦикла; 
			КонецЦикла; 
		КонецЦикла; 

	КонецЦикла; 
	
	//Обработка остальных категорий

	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаСписанияМатериалов();
	
	тзСписаниеМатериалов = ТаблицаСписаниеМатериалов.Выгрузить();
	Запрос.УстановитьПараметр("тзСписаниеМатериалов", тзСписаниеМатериалов);
	Запрос.УстановитьПараметр("ПодразделениеЗатрат", ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	ВыборкаОбщийИтог.Следующий(); 

	ВыборкаПоСкладу = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаПоСкладу.Следующий() Цикл 

		Если Не ЗначениеЗаполнено(ВыборкаПоСкладу.Склад) Тогда
			Продолжить;
		КонецЕсли;	
		
		ВыборкаПоСчетуЗатрат = ВыборкаПоСкладу.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		Пока ВыборкаПоСчетуЗатрат.Следующий() Цикл 
		
			ВыборкаПоПодразделениюЗатрат = ВыборкаПоСчетуЗатрат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
			Пока ВыборкаПоПодразделениюЗатрат.Следующий() Цикл 

				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Организация", Объект.Организация);
				СтруктураПараметров.Вставить("ДатаПериода", Объект.ДатаПериода);
				СтруктураПараметров.Вставить("Склад", ВыборкаПоСкладу.Склад);
				СтруктураПараметров.Вставить("СчетЗатрат", ВыборкаПоСчетуЗатрат.СчетЗатрат);
				СтруктураПараметров.Вставить("СтатьяЗатрат", СтатьяЗатратСтоимостьЗапчастей);
				СтруктураПараметров.Вставить("ПодразделениеЗатрат", ВыборкаПоПодразделениюЗатрат.ПодразделениеЗатрат);
				СтруктураПараметров.Вставить("ТранспортноеСредство", Неопределено);
				СтруктураПараметров.Вставить("Комментарий", "#Списание материалов " + ВыборкаПоПодразделениюЗатрат.ПодразделениеЗатрат);
				СтруктураПараметров.Вставить("СчетаУчетаЗатратВТаблице", Ложь);
				
				СоздаватьДокумент = Ложь;
				ДокументТребованиеНакладная = ПолучитьДокументТребованиеНакладная(СтруктураПараметров, СоздаватьДокумент);
		
				Если ДокументТребованиеНакладная <> Неопределено Тогда
					Возврат Истина;
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла; 
	
	Возврат Ложь;
	
КонецФункции	

&НаСервере
Функция ПолучитьДокументТребованиеНакладная(СтруктураПараметров, СоздаватьДокумент=Истина)

	Организация = СтруктураПараметров.Организация;
	ДатаПериода = СтруктураПараметров.ДатаПериода;                                                        
	Склад = СтруктураПараметров.Склад;
	Комментарий = СтруктураПараметров.Комментарий;
	СчетаУчетаЗатратВТаблице = СтруктураПараметров.СчетаУчетаЗатратВТаблице;
	
	СчетЗатрат = ?(СтруктураПараметров.Свойство("СчетЗатрат"),СтруктураПараметров.СчетЗатрат, Неопределено);
	СтатьяЗатрат = ?(СтруктураПараметров.Свойство("СтатьяЗатрат"),СтруктураПараметров.СтатьяЗатрат, Неопределено);
	ПодразделениеЗатрат = ?(СтруктураПараметров.Свойство("ПодразделениеЗатрат"),СтруктураПараметров.ПодразделениеЗатрат, Неопределено);
	ТранспортноеСредство = ?(СтруктураПараметров.Свойство("ТранспортноеСредство"),СтруктураПараметров.ТранспортноеСредство, Неопределено);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТребованиеНакладная.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ТребованиеНакладная КАК ТребованиеНакладная
		|ГДЕ
		|	НАЧАЛОПЕРИОДА(ТребованиеНакладная.Дата, МЕСЯЦ) = &Дата
		|	И ТребованиеНакладная.Организация = &Организация
		|	И ТребованиеНакладная.Склад = &Склад
		|	И ТребованиеНакладная.СчетаУчетаЗатратВТаблице = &СчетаУчетаЗатратВТаблице
		|	И ТребованиеНакладная.Комментарий ПОДОБНО &Комментарий";
		
	
	Запрос.УстановитьПараметр("Дата", НачалоМесяца(ДатаПериода));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Комментарий", Комментарий);
	Запрос.УстановитьПараметр("СчетаУчетаЗатратВТаблице", СчетаУчетаЗатратВТаблице);

	Если Не СчетаУчетаЗатратВТаблице Тогда //Отбор по реквизитам шапки документа	
		
		Запрос.Текст = Запрос.Текст + "
		|	И ТребованиеНакладная.СчетЗатрат = &СчетЗатрат
		|	И ТребованиеНакладная.ПодразделениеЗатрат = &ПодразделениеЗатрат
		|	И ТребованиеНакладная.Субконто1 = &СтатьяЗатрат";
		
		Запрос.УстановитьПараметр("СчетЗатрат", СчетЗатрат);
		Запрос.УстановитьПараметр("ПодразделениеЗатрат", ПодразделениеЗатрат);
		Запрос.УстановитьПараметр("СтатьяЗатрат", СтатьяЗатрат);
		
		Если ТранспортноеСредство <> Неопределено Тогда 
			Запрос.Текст = Запрос.Текст + " И ТребованиеНакладная.Субконто3 = &ТранспортноеСредство";
			Запрос.УстановитьПараметр("ТранспортноеСредство", ТранспортноеСредство);
		КонецЕсли;	
		
	КонецЕсли;	
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	КонецЦикла;
	
	Если СоздаватьДокумент Тогда

		ДокОбъект = Документы.ТребованиеНакладная.СоздатьДокумент();
		ДокОбъект.Дата = КонецМесяца(ДатаПериода) - 1;
		ДокОбъект.Организация = Организация;
		ДокОбъект.Склад = Склад;    
		
		Если Не СчетаУчетаЗатратВТаблице Тогда //Заполнение реквизитов шапки документа	
			
			ДокОбъект.СчетЗатрат = СчетЗатрат;
			ДокОбъект.ПодразделениеЗатрат = ПодразделениеЗатрат;
			
			ДокОбъект.Субконто1 = СтатьяЗатрат;
			Если ТранспортноеСредство <> Неопределено Тогда 
				ДокОбъект.Субконто2 = Справочники.НоменклатурныеГруппы.ПустаяСсылка();
				ДокОбъект.Субконто3 = ТранспортноеСредство;
			КонецЕсли;
			
		КонецЕсли;
		
		ДокОбъект.ВидОперации = Перечисления.ВидыОперацийРасходМатериалов.ИспользованиеМатериалов;
		ДокОбъект.СчетаУчетаЗатратВТаблице = СчетаУчетаЗатратВТаблице; 
		ДокОбъект.СпособУчетаНДС = Перечисления.СпособыУчетаНДС.ПринимаетсяКВычету; 
		ДокОбъект.Ответственный = Пользователи.ТекущийПользователь();
		ДокОбъект.Комментарий = Комментарий;
		
	Иначе
		ДокОбъект = Неопределено;
	КонецЕсли;
	
	Возврат ДокОбъект;
	
КонецФункции	

&НаСервере
Процедура ЗагрузитьСписаниеМатериаловНаСервере()
	
	//Подключение к УАТ
	ПараметрыПодключения = ЮЦАУ.ПолучитьПараметрыПодключения_УАТ(Объект.Организация);

	Если ПараметрыПодключения = Неопределено Тогда
		Сообщить("Не определены параметры подключения к УАТ!");
		Возврат;
	КонецЕсли;	
	
	Попытка		
		Если ПараметрыПодключения.Порт <= 0 Тогда 
			HTTPСоединение = Новый HTTPСоединение(ПараметрыПодключения.АдресСервера,,ПараметрыПодключения.Пользователь,ПараметрыПодключения.Пароль);
		Иначе 
			HTTPСоединение = Новый HTTPСоединение(ПараметрыПодключения.АдресСервера,ПараметрыПодключения.Порт,ПараметрыПодключения.Пользователь,ПараметрыПодключения.Пароль);
		КонецЕсли;	
	Исключение
		Сообщить("Не удалось подключиться по причине: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ДатаНачала = НачалоМесяца(Объект.ДатаПериода);
	ДатаКонца = КонецМесяца(Объект.ДатаПериода);
	//http://localhost/UAT/hs/api_uat/ItemsWriteOff?StartDate=01.04.2023&EndDate=30.04.2023
	РесурсНаСервере = "/UAT/hs/api_uat/ItemsWriteOff?StartDate="+Формат(ДатаНачала,"ДЛФ=Д")+"&EndDate="+Формат(ДатаКонца,"ДЛФ=Д");
	
	HTTPЗапрос = Новый HTTPЗапрос(РесурсНаСервере);
	HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод("GET", HTTPЗапрос);
			
	//Получаем ответный текст или текст ошибки  
	Если HTTPОтвет.КодСостояния = 401 Тогда
		Сообщить("Не удалось авторизоваться в программе УАТ. Неверный логин или пароль. HTTPОтвет.КодСостояния: " + HTTPОтвет.КодСостояния);
	ИначеЕсли HTTPОтвет.КодСостояния = 500 Тогда
		Сообщить("HTTPОтвет.КодСостояния: " + HTTPОтвет.КодСостояния);
	Иначе	

		СтрокаJSON = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ПолучитьСтруктуруИзJSON(СтрокаJSON);
		ДесериализоватьJSON_СписаниеМатериалов(СтрокаJSON);  

	КонецЕсли;		
	
	ЭтаФорма.Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСписаниеМатериалов(Команда)
	ЗагрузитьСписаниеМатериаловНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДесериализоватьJSON_СписаниеМатериалов(СтрокаJSON)
	
	СоздаватьОбъекты = Истина;
	
	МассивПолейДат = Новый Массив;
	МассивПолейДат.Добавить("Период");
	МассивПолейДат.Добавить("ДатаПериода");
	МассивПолейДат.Добавить("ФизлицоДатаРождения");
	СписокСтрок = ДесериализоватьJSON(СтрокаJSON, МассивПолейДат);	
	
	ТаблицаСписаниеМатериалов.Очистить();

	Для Каждого СтруктураСтроки Из СписокСтрок.ДанныеСписаниеМатериалов Цикл
		
		Склад = Неопределено;
		ТранспортноеСредство = Неопределено;
		Номенклатура = Неопределено;  
		НоменклатураУАТ = Неопределено;
		Подразделение = Неопределено;
		
		Если СтруктураСтроки.Свойство("Склад") Тогда
			Склад = ПолучитьСклад(СтруктураСтроки.Склад);
		КонецЕсли;	

		Если СтруктураСтроки.Свойство("ТранспортноеСредство") Тогда
			ТранспортноеСредство = ПолучитьТранспортноеСредство(СтруктураСтроки.ТранспортноеСредство);
		КонецЕсли;	
		
		Если СтруктураСтроки.Свойство("Подразделение") Тогда                                 
			Подразделение = ПолучитьПодразделение(СтруктураСтроки.Подразделение);
		КонецЕсли;	

		Если СтруктураСтроки.Свойство("Номенклатура") Тогда                                 
			Номенклатура = ПолучитьНоменклатуру(СтруктураСтроки.Номенклатура);
			НоменклатураУАТ = СтруктураСтроки.Номенклатура.Наименование; 
		КонецЕсли;	

		НоваяСтрока = ТаблицаСписаниеМатериалов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
		НоваяСтрока.Склад = Склад;
		НоваяСтрока.ТранспортноеСредство = ТранспортноеСредство;
		НоваяСтрока.ПодразделениеЗатрат = Подразделение;

		Если ЗначениеЗаполнено(Номенклатура) Тогда
			СтруктураСчетаУчета = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(Объект.Организация, Номенклатура);
			НоваяСтрока.Счет = СтруктураСчетаУчета.СчетУчета;
		КонецЕсли;	
		
		НоваяСтрока.Номенклатура = Номенклатура;    
		НоваяСтрока.НоменклатураУАТ = НоменклатураУАТ;    
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тзСписаниеМатериалов.Склад КАК Склад,
		|	тзСписаниеМатериалов.ТранспортноеСредство КАК ТранспортноеСредство,
		|	тзСписаниеМатериалов.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	тзСписаниеМатериалов.НоменклатураУАТ КАК НоменклатураУАТ,
		|	тзСписаниеМатериалов.Номенклатура КАК Номенклатура,
		|	тзСписаниеМатериалов.Счет КАК Счет,
		|	тзСписаниеМатериалов.Количество КАК Количество
		|ПОМЕСТИТЬ ВТ_СписаниеМатериалов
		|ИЗ
		|	&тзСписаниеМатериалов КАК тзСписаниеМатериалов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СписаниеМатериалов.Склад КАК Склад,
		|	ВТ_СписаниеМатериалов.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ВТ_СписаниеМатериалов.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	ВТ_СписаниеМатериалов.НоменклатураУАТ КАК НоменклатураУАТ,
		|	ВТ_СписаниеМатериалов.Номенклатура КАК Номенклатура,
		|	ВТ_СписаниеМатериалов.Счет КАК Счет,
		|	ВТ_СписаниеМатериалов.Количество КАК Количество,
		|	ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СчетЗатрат КАК СчетЗатрат,
		|	ВЗ_ЮЦАУ_СоответствияСчетовУчетаНоменклатурыИСтатейЗатрат.СтатьяЗатрат КАК СтатьяЗатрат
		|ИЗ
		|	ВТ_СписаниеМатериалов КАК ВТ_СписаниеМатериалов
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЮЦАУ_СоответствияСчетовУчетаНоменклатурыИСтатейЗатрат.Счет КАК Счет,
		|			ЮЦАУ_СоответствияСчетовУчетаНоменклатурыИСтатейЗатрат.СтатьяЗатрат КАК СтатьяЗатрат
		|		ИЗ
		|			РегистрСведений.ЮЦАУ_СоответствияСчетовУчетаНоменклатурыИСтатейЗатрат КАК ЮЦАУ_СоответствияСчетовУчетаНоменклатурыИСтатейЗатрат) КАК ВЗ_ЮЦАУ_СоответствияСчетовУчетаНоменклатурыИСтатейЗатрат
		|		ПО ВТ_СписаниеМатериалов.Счет = ВЗ_ЮЦАУ_СоответствияСчетовУчетаНоменклатурыИСтатейЗатрат.Счет
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.Подразделение КАК Подразделение,
		|			ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СчетЗатрат КАК СчетЗатрат
		|		ИЗ
		|			РегистрСведений.ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТ.СрезПоследних(&ДатаПериода, ) КАК ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних) КАК ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних
		|		ПО ВТ_СписаниеМатериалов.ПодразделениеЗатрат = ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.Подразделение
		|
		|УПОРЯДОЧИТЬ ПО
		|	Склад,
		|	ПодразделениеЗатрат,
		|	ТранспортноеСредство
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	тзСписаниеМатериалов = ТаблицаСписаниеМатериалов.Выгрузить();
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("тзСписаниеМатериалов", тзСписаниеМатериалов);
	Запрос.УстановитьПараметр("ДатаПериода", КонецМесяца(Объект.ДатаПериода));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаСписаниеМатериалов.Загрузить(РезультатЗапроса.Выгрузить());   
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыСписанияМатериаловНаСервере()
	
	СтатьяЗатратСтоимостьЗапчастей = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("СтатьяЗатратСтоимостьЗапчастей", Объект.Организация, Объект.ДатаПериода);

	//Обработка подразделения "Автобусная колонна (пассажирские перевозки)"
	ПодразделениеАвтоколоннаПассажирскиеПеревозки = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПодразделениеАвтоколоннаПассажирскиеПеревозки");
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаСписанияМатериалов(ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
	тзСписаниеМатериалов = ТаблицаСписаниеМатериалов.Выгрузить();
	Запрос.УстановитьПараметр("тзСписаниеМатериалов", тзСписаниеМатериалов);
	Запрос.УстановитьПараметр("ПодразделениеЗатрат", ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	ВыборкаОбщийИтог.Следующий(); 

	ВыборкаПоСкладу = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаПоСкладу.Следующий() Цикл 

		Если Не ЗначениеЗаполнено(ВыборкаПоСкладу.Склад) Тогда
			Продолжить;
		КонецЕсли;	
		
		ВыборкаПоСчетуЗатрат = ВыборкаПоСкладу.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		Пока ВыборкаПоСчетуЗатрат.Следующий() Цикл 
		
			ВыборкаПоПодразделениюЗатрат = ВыборкаПоСчетуЗатрат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
			Пока ВыборкаПоПодразделениюЗатрат.Следующий() Цикл 
		
				ВыборкаПоТранспортномуСредству = ВыборкаПоПодразделениюЗатрат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
				Пока ВыборкаПоТранспортномуСредству.Следующий() Цикл 

					СтруктураПараметров = Новый Структура;
					СтруктураПараметров.Вставить("Организация", Объект.Организация);
					СтруктураПараметров.Вставить("ДатаПериода", Объект.ДатаПериода);
					СтруктураПараметров.Вставить("Склад", ВыборкаПоСкладу.Склад);
					СтруктураПараметров.Вставить("СчетЗатрат", ВыборкаПоСчетуЗатрат.СчетЗатрат);
					СтруктураПараметров.Вставить("СтатьяЗатрат", СтатьяЗатратСтоимостьЗапчастей);
					СтруктураПараметров.Вставить("ПодразделениеЗатрат", ВыборкаПоПодразделениюЗатрат.ПодразделениеЗатрат);
					СтруктураПараметров.Вставить("ТранспортноеСредство", ВыборкаПоТранспортномуСредству.ТранспортноеСредство);
					СтруктураПараметров.Вставить("Комментарий", "#Списание материалов " + ВыборкаПоТранспортномуСредству.ТранспортноеСредство);
					СтруктураПараметров.Вставить("СчетаУчетаЗатратВТаблице", Ложь);

					ДокументТребованиеНакладная = ПолучитьДокументТребованиеНакладная(СтруктураПараметров);	

					Если ДокументТребованиеНакладная.Проведен Тогда //Проведенные документы не перезаписываются!
						Продолжить;
					КонецЕсли;

					ДокументТребованиеНакладная.Материалы.Очистить();
					
					ВыборкаПоНоменклатуре = ВыборкаПоТранспортномуСредству.Выбрать(); 
					Пока ВыборкаПоНоменклатуре.Следующий() Цикл 
					
						НоваяСтрока = ДокументТребованиеНакладная.Материалы.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПоНоменклатуре); 
						НоваяСтрока.Количество = ВыборкаПоНоменклатуре.Количество;
						НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.ЕдиницаИзмерения;
						НоваяСтрока.Коэффициент = 1;
						НоваяСтрока.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
						НоваяСтрока.Субконто1 = СтатьяЗатратСтоимостьЗапчастей; 
						НоваяСтрока.СпособУчетаНДС = Перечисления.СпособыУчетаНДС.ПринимаетсяКВычету;
						
					КонецЦикла; 

					ДокументТребованиеНакладная.Записать(РежимЗаписиДокумента.Запись);

					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Записан документ: " + ДокументТребованиеНакладная;
					Сообщение.Сообщить();
					
				КонецЦикла; 
			КонецЦикла; 
		КонецЦикла; 

	КонецЦикла; 
	
	//Обработка остальных категорий
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаСписанияМатериалов();
	
	тзСписаниеМатериалов = ТаблицаСписаниеМатериалов.Выгрузить();
	Запрос.УстановитьПараметр("тзСписаниеМатериалов", тзСписаниеМатериалов);
	Запрос.УстановитьПараметр("ПодразделениеЗатрат", ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	ВыборкаОбщийИтог.Следующий(); 

	ВыборкаПоСкладу = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаПоСкладу.Следующий() Цикл 

		Если Не ЗначениеЗаполнено(ВыборкаПоСкладу.Склад) Тогда
			Продолжить;
		КонецЕсли;	
		
		ВыборкаПоСчетуЗатрат = ВыборкаПоСкладу.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		Пока ВыборкаПоСчетуЗатрат.Следующий() Цикл 
		
			ВыборкаПоПодразделениюЗатрат = ВыборкаПоСчетуЗатрат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
			Пока ВыборкаПоПодразделениюЗатрат.Следующий() Цикл 

				СтруктураПараметров = Новый Структура;
				СтруктураПараметров.Вставить("Организация", Объект.Организация);
				СтруктураПараметров.Вставить("ДатаПериода", Объект.ДатаПериода);
				СтруктураПараметров.Вставить("Склад", ВыборкаПоСкладу.Склад);
				СтруктураПараметров.Вставить("СчетЗатрат", ВыборкаПоСчетуЗатрат.СчетЗатрат);
				СтруктураПараметров.Вставить("СтатьяЗатрат", СтатьяЗатратСтоимостьЗапчастей);
				СтруктураПараметров.Вставить("ПодразделениеЗатрат", ВыборкаПоПодразделениюЗатрат.ПодразделениеЗатрат);
				СтруктураПараметров.Вставить("ТранспортноеСредство", Неопределено);
				СтруктураПараметров.Вставить("Комментарий", "#Списание материалов " + ВыборкаПоПодразделениюЗатрат.ПодразделениеЗатрат);
				СтруктураПараметров.Вставить("СчетаУчетаЗатратВТаблице", Ложь);

				ДокументТребованиеНакладная = ПолучитьДокументТребованиеНакладная(СтруктураПараметров);

				Если ДокументТребованиеНакладная.Проведен Тогда //Проведенные документы не перезаписываются!
					Продолжить;
				КонецЕсли;
				
				ДокументТребованиеНакладная.Материалы.Очистить();
		
				ВыборкаПоНоменклатуре = ВыборкаПоПодразделениюЗатрат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
				Пока ВыборкаПоНоменклатуре.Следующий() Цикл 
					
					НоваяСтрока = ДокументТребованиеНакладная.Материалы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПоНоменклатуре); 
					НоваяСтрока.Количество = ВыборкаПоНоменклатуре.Количество;
					НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.ЕдиницаИзмерения;
					НоваяСтрока.Коэффициент = 1;
					НоваяСтрока.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
					НоваяСтрока.Субконто1 = СтатьяЗатратСтоимостьЗапчастей; 
					НоваяСтрока.СпособУчетаНДС = Перечисления.СпособыУчетаНДС.ПринимаетсяКВычету;
						
				КонецЦикла; 
		
				ДокументТребованиеНакладная.Записать(РежимЗаписиДокумента.Запись);
		
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Записан документ: " + ДокументТребованиеНакладная;
				Сообщение.Сообщить();
				
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыСписаниеМатериалов(Команда)

	СуществуютДокументыВПериоде = СуществуютДокументыСписанияМатериаловВПериоде("#Списание материалов");
	
	Если СуществуютДокументыВПериоде Тогда
		
		ТекстВопроса = НСтр("ru = 'Существующие документы будут перезаполнены. Продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ВопросПередФормированиемДокументовСписаниеМатериаловЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
			НСтр("ru = 'Формирование документов'"));
	
	Иначе	
		СоздатьДокументыСписанияМатериаловНаСервере();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстЗапросаСписанияМатериалов(ПодразделениеЗатрат=Неопределено)

	Если ПодразделениеЗатрат = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПодразделениеАвтоколоннаПассажирскиеПеревозки") Тогда 
		
		ТекстЗапроса = 	
		"ВЫБРАТЬ
		|	тзСписаниеМатериалов.Склад КАК Склад,
		|	тзСписаниеМатериалов.ТранспортноеСредство КАК ТранспортноеСредство,
		|	тзСписаниеМатериалов.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	тзСписаниеМатериалов.Номенклатура КАК Номенклатура,
		|	тзСписаниеМатериалов.СчетЗатрат КАК СчетЗатрат,
		|	тзСписаниеМатериалов.Счет КАК Счет,
		|	тзСписаниеМатериалов.Количество КАК Количество
		|ПОМЕСТИТЬ ВТ_СписаниеМатериалов
		|ИЗ
		|	&тзСписаниеМатериалов КАК тзСписаниеМатериалов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СписаниеМатериалов.Склад КАК Склад,
		|	ВТ_СписаниеМатериалов.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ВТ_СписаниеМатериалов.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	ВТ_СписаниеМатериалов.Номенклатура КАК Номенклатура,
		|	ВТ_СписаниеМатериалов.СчетЗатрат КАК СчетЗатрат,
		|	ВТ_СписаниеМатериалов.Счет КАК Счет,
		|	СУММА(ВТ_СписаниеМатериалов.Количество) КАК Количество
		|ИЗ
		|	ВТ_СписаниеМатериалов КАК ВТ_СписаниеМатериалов
		|ГДЕ
		|	ВТ_СписаниеМатериалов.ПодразделениеЗатрат = &ПодразделениеЗатрат
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СписаниеМатериалов.Счет,
		|	ВТ_СписаниеМатериалов.СчетЗатрат,
		|	ВТ_СписаниеМатериалов.ПодразделениеЗатрат,
		|	ВТ_СписаниеМатериалов.ТранспортноеСредство,
		|	ВТ_СписаниеМатериалов.Номенклатура,
		|	ВТ_СписаниеМатериалов.Склад
		|
		|УПОРЯДОЧИТЬ ПО
		|	Склад,
		|	СчетЗатрат,
		|	ПодразделениеЗатрат,
		|	ТранспортноеСредство
		|ИТОГИ
		|	СУММА(Количество)
		|ПО
		|	ОБЩИЕ,
		|	Склад,
		|	СчетЗатрат,
		|	ПодразделениеЗатрат,
		|	ТранспортноеСредство
		|АВТОУПОРЯДОЧИВАНИЕ";
		
	Иначе
		
		ТекстЗапроса = 	
		"ВЫБРАТЬ
		|	тзСписаниеМатериалов.Склад КАК Склад,
		|	тзСписаниеМатериалов.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	тзСписаниеМатериалов.Номенклатура КАК Номенклатура,
		|	тзСписаниеМатериалов.СчетЗатрат КАК СчетЗатрат,
		|	тзСписаниеМатериалов.Счет КАК Счет,
		|	тзСписаниеМатериалов.Количество КАК Количество
		|ПОМЕСТИТЬ ВТ_СписаниеМатериалов
		|ИЗ
		|	&тзСписаниеМатериалов КАК тзСписаниеМатериалов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СписаниеМатериалов.Склад КАК Склад,
		|	ВТ_СписаниеМатериалов.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	ВТ_СписаниеМатериалов.Номенклатура КАК Номенклатура,
		|	ВТ_СписаниеМатериалов.СчетЗатрат КАК СчетЗатрат,
		|	ВТ_СписаниеМатериалов.Счет КАК Счет,
		|	СУММА(ВТ_СписаниеМатериалов.Количество) КАК Количество
		|ИЗ
		|	ВТ_СписаниеМатериалов КАК ВТ_СписаниеМатериалов
		|ГДЕ
		|	ВТ_СписаниеМатериалов.ПодразделениеЗатрат <> &ПодразделениеЗатрат
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_СписаниеМатериалов.Счет,
		|	ВТ_СписаниеМатериалов.СчетЗатрат,
		|	ВТ_СписаниеМатериалов.ПодразделениеЗатрат,
		|	ВТ_СписаниеМатериалов.Номенклатура,
		|	ВТ_СписаниеМатериалов.Склад
		|
		|УПОРЯДОЧИТЬ ПО
		|	Склад
		|ИТОГИ
		|	СУММА(Количество)
		|ПО
		|	ОБЩИЕ,
		|	Склад,
		|	СчетЗатрат,
		|	ПодразделениеЗатрат
		|АВТОУПОРЯДОЧИВАНИЕ";
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;	
	
КонецФункции		

&НаКлиенте
Процедура ВопросПередФормированиемДокументовСписаниеМатериаловЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		СоздатьДокументыСписанияМатериаловНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуАналоговНоменклатурыНаСервере()
	
	ТаблицаАналогиНоменклатуры.Очистить();   
	
	//Топливо
	тзАналогиНоменклатуры = ТаблицаПотреблениеТоплива.Выгрузить(,"Склад, Номенклатура");  
	
	//Тех. жидкости
	Для Каждого ТекСтрока Из ТаблицаПотреблениеТехническихЖидкостей Цикл
		НоваяСтрока = тзАналогиНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;	
	
	тзАналогиНоменклатуры.Свернуть("Склад, Номенклатура",);
	
	ТаблицаАналогиНоменклатуры.Загрузить(тзАналогиНоменклатуры);  
	ТаблицаАналогиНоменклатуры.Сортировать("Склад, Номенклатура");
	
	Для Каждого ТекСтрока Из ТаблицаАналогиНоменклатуры Цикл
		ТекСтрока.АналогНоменклатуры = ТекСтрока.Номенклатура; 
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуАналоговНоменклатуры(Команда)
	ЗаполнитьТаблицуАналоговНоменклатурыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДесериализоватьJSON_ПотреблениеТехническихЖидкостей(СтрокаJSON)
	
	СоздаватьОбъекты = Истина;
	
	МассивПолейДат = Новый Массив;
	МассивПолейДат.Добавить("Период");
	МассивПолейДат.Добавить("ДатаПериода");
	МассивПолейДат.Добавить("ФизлицоДатаРождения");
	СписокСтрок = ДесериализоватьJSON(СтрокаJSON, МассивПолейДат);	
	
	ТаблицаПотреблениеТехническихЖидкостей.Очистить();

	Для Каждого СтруктураСтроки Из СписокСтрок.ДанныеПотреблениеТехническихЖидкостей Цикл
		
		Склад = Неопределено;
		ТранспортноеСредство = Неопределено;
		Номенклатура = Неопределено;
		Подразделение = Неопределено;

		Если СтруктураСтроки.Свойство("Склад") Тогда
			Склад = ПолучитьСклад(СтруктураСтроки.Склад);
		КонецЕсли;	

		Если СтруктураСтроки.Свойство("ТранспортноеСредство") Тогда
			ТранспортноеСредство = ПолучитьТранспортноеСредство(СтруктураСтроки.ТранспортноеСредство);
		КонецЕсли;	
		
		Если СтруктураСтроки.Свойство("Номенклатура") Тогда                                 
			Номенклатура = ПолучитьНоменклатуру(СтруктураСтроки.Номенклатура);
		КонецЕсли;	

		Если СтруктураСтроки.Свойство("Подразделение") Тогда                                 
			Подразделение = ПолучитьПодразделение(СтруктураСтроки.Подразделение);
		КонецЕсли;	

		НоваяСтрока = ТаблицаПотреблениеТехническихЖидкостей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
		НоваяСтрока.Склад = Склад;
		НоваяСтрока.ТранспортноеСредство = ТранспортноеСредство;
		НоваяСтрока.ПодразделениеЗатрат = Подразделение;
		НоваяСтрока.Номенклатура = Номенклатура;    
			
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	тзАналогиНоменклатуры.Склад КАК Склад,
		|	тзАналогиНоменклатуры.Номенклатура КАК Номенклатура,
		|	тзАналогиНоменклатуры.АналогНоменклатуры КАК АналогНоменклатуры
		|ПОМЕСТИТЬ ВТ_АналогиНоменклатуры
		|ИЗ
		|	&тзАналогиНоменклатуры КАК тзАналогиНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	тзПотреблениеТехническихЖидкостей.Склад КАК Склад,
		|	тзПотреблениеТехническихЖидкостей.ТранспортноеСредство КАК ТранспортноеСредство,
		|	тзПотреблениеТехническихЖидкостей.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	тзПотреблениеТехническихЖидкостей.Номенклатура КАК Номенклатура,
		|	тзПотреблениеТехническихЖидкостей.РасходПоФакту КАК РасходПоФакту
		|ПОМЕСТИТЬ ВТ_ПотреблениеТехническихЖидкостей
		|ИЗ
		|	&тзПотреблениеТехническихЖидкостей КАК тзПотреблениеТехническихЖидкостей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПотреблениеТехническихЖидкостей.Склад КАК Склад,
		|	ВТ_ПотреблениеТехническихЖидкостей.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ВТ_ПотреблениеТехническихЖидкостей.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	ВТ_ПотреблениеТехническихЖидкостей.Номенклатура КАК Номенклатура,
		|	ВТ_ПотреблениеТехническихЖидкостей.РасходПоФакту КАК РасходПоФакту,
		|	ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СчетЗатрат КАК СчетЗатрат,
		|	ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СчетУчетаГСМ КАК СчетУчетаГСМ
		|ПОМЕСТИТЬ ВТ_ПотреблениеТехническихЖидкостейИтог
		|ИЗ
		|	ВТ_ПотреблениеТехническихЖидкостей КАК ВТ_ПотреблениеТехническихЖидкостей
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.Подразделение КАК Подразделение,
		|			ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СкладТехническиеЖидкости КАК СкладТехническиеЖидкости,
		|			ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СчетЗатрат КАК СчетЗатрат,
		|			ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.СчетУчетаГСМ КАК СчетУчетаГСМ
		|		ИЗ
		|			РегистрСведений.ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТ.СрезПоследних(&ДатаПериода, ) КАК ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних) КАК ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних
		|		ПО ВТ_ПотреблениеТехническихЖидкостей.ПодразделениеЗатрат = ВЗ_ЮЦАУ_НастройкаЗагрузкиСписанияГСМиТМЦизУАТСрезПоследних.Подразделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ПотреблениеТехническихЖидкостейИтог.Склад КАК Склад,
		|	ВТ_ПотреблениеТехническихЖидкостейИтог.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ВТ_ПотреблениеТехническихЖидкостейИтог.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	ВТ_ПотреблениеТехническихЖидкостейИтог.СчетЗатрат КАК СчетЗатрат,
		|	ВТ_ПотреблениеТехническихЖидкостейИтог.РасходПоФакту КАК РасходПоФакту,
		|	ВТ_ПотреблениеТехническихЖидкостейИтог.СчетУчетаГСМ КАК СчетУчетаГСМ,
		|	ЕСТЬNULL(ВЗ_АналогиНоменклатуры.АналогНоменклатуры, ВТ_ПотреблениеТехническихЖидкостейИтог.Номенклатура) КАК Номенклатура
		|ИЗ
		|	ВТ_ПотреблениеТехническихЖидкостейИтог КАК ВТ_ПотреблениеТехническихЖидкостейИтог
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_АналогиНоменклатуры.Склад КАК Склад,
		|			ВТ_АналогиНоменклатуры.Номенклатура КАК Номенклатура,
		|			ВТ_АналогиНоменклатуры.АналогНоменклатуры КАК АналогНоменклатуры
		|		ИЗ
		|			ВТ_АналогиНоменклатуры КАК ВТ_АналогиНоменклатуры) КАК ВЗ_АналогиНоменклатуры
		|		ПО ВТ_ПотреблениеТехническихЖидкостейИтог.Склад = ВЗ_АналогиНоменклатуры.Склад
		|			И ВТ_ПотреблениеТехническихЖидкостейИтог.Номенклатура = ВЗ_АналогиНоменклатуры.Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Склад,
		|	ПодразделениеЗатрат,
		|	ТранспортноеСредство
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	тзПотреблениеТехническихЖидкостей = ТаблицаПотреблениеТехническихЖидкостей.Выгрузить();
	тзАналогиНоменклатуры = ТаблицаАналогиНоменклатуры.Выгрузить();
	
	Запрос.УстановитьПараметр("тзПотреблениеТехническихЖидкостей", тзПотреблениеТехническихЖидкостей);
	Запрос.УстановитьПараметр("тзАналогиНоменклатуры", тзАналогиНоменклатуры);
	Запрос.УстановитьПараметр("ДатаПериода", КонецМесяца(Объект.ДатаПериода));
	
	РезультатЗапроса = Запрос.Выполнить();
	
    ТаблицаПотреблениеТехническихЖидкостей.Загрузить(РезультатЗапроса.Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПотреблениеТехническихЖидкостейНаСервере()

	//Подключение к УАТ
	ПараметрыПодключения = ЮЦАУ.ПолучитьПараметрыПодключения_УАТ(Объект.Организация);

	Если ПараметрыПодключения = Неопределено Тогда
		Сообщить("Не определены параметры подключения к УАТ!");
		Возврат;
	КонецЕсли;	
	
	Попытка		
		Если ПараметрыПодключения.Порт <= 0 Тогда 
			HTTPСоединение = Новый HTTPСоединение(ПараметрыПодключения.АдресСервера,,ПараметрыПодключения.Пользователь,ПараметрыПодключения.Пароль);
		Иначе 
			HTTPСоединение = Новый HTTPСоединение(ПараметрыПодключения.АдресСервера,ПараметрыПодключения.Порт,ПараметрыПодключения.Пользователь,ПараметрыПодключения.Пароль);
		КонецЕсли;	
	Исключение
		Сообщить("Не удалось подключиться по причине: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ДатаНачала = НачалоМесяца(Объект.ДатаПериода);
	ДатаКонца = КонецМесяца(Объект.ДатаПериода);
	РесурсНаСервере = "/UAT/hs/api_uat/TechFluidsConsumption?StartDate="+Формат(ДатаНачала,"ДЛФ=Д")+"&EndDate="+Формат(ДатаКонца,"ДЛФ=Д");
	
	HTTPЗапрос = Новый HTTPЗапрос(РесурсНаСервере);
	HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод("GET", HTTPЗапрос);
			
	//Получаем ответный текст или текст ошибки  
	Если HTTPОтвет.КодСостояния = 401 Тогда
		Сообщить("Не удалось авторизоваться в программе УАТ. Неверный логин или пароль. HTTPОтвет.КодСостояния: " + HTTPОтвет.КодСостояния);
	ИначеЕсли HTTPОтвет.КодСостояния = 500 Тогда
		Сообщить("HTTPОтвет.КодСостояния: " + HTTPОтвет.КодСостояния);
	Иначе	

		СтрокаJSON = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ПолучитьСтруктуруИзJSON(СтрокаJSON);
		ДесериализоватьJSON_ПотреблениеТехническихЖидкостей(СтрокаJSON);  

	КонецЕсли;		
	
	ЭтаФорма.Модифицированность = Истина;        
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПотреблениеТехническихЖидкостей(Команда)
	ЗагрузитьПотреблениеТехническихЖидкостейНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередФормированиемДокументовПотребленияТехническихЖидкостейЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		СоздатьДокументыПотребленияТехническихЖидкостейНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыПотребленияТехническихЖидкостейНаСервере()   
	СоздатьДокументыПотребленияТопливаИТехническихЖидкостейНаСервере(ТаблицаПотреблениеТехническихЖидкостей.Выгрузить(), "#Потребление тех. жидкостей");
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыПотребленияТехническихЖидкостей(Команда)

	СуществуютДокументыВПериоде = СуществуютДокументыПотребленияТопливаИТехническихЖидкостейВПериоде("#Потребление тех. жидкостей");
	
	Если СуществуютДокументыВПериоде Тогда
		
		ТекстВопроса = НСтр("ru = 'Существующие документы будут перезаполнены. Продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ВопросПередФормированиемДокументовПотребленияТехническихЖидкостейЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
			НСтр("ru = 'Формирование документов'"));
	
	Иначе	
		СоздатьДокументыПотребленияТехническихЖидкостейНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДесериализоватьJSON_ДокументыТМЦУАТ(СтрокаJSON)
	
	СоздаватьОбъекты = Истина;
	
	МассивПолейДат = Новый Массив;
	МассивПолейДат.Добавить("Период");
	МассивПолейДат.Добавить("ДатаПериода");
	СписокСтрок = ДесериализоватьJSON(СтрокаJSON, МассивПолейДат);	
	
	ТаблицаДокументыТМЦУАТ.Очистить();

	Для Каждого СтруктураСтроки Из СписокСтрок.ДанныеТаблицаДокументовУАТ Цикл
		
		НоваяСтрока = ТаблицаДокументыТМЦУАТ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураСтроки);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДокументыТМЦУАТНаСервере()

	//Подключение к УАТ
	ПараметрыПодключения = ЮЦАУ.ПолучитьПараметрыПодключения_УАТ(Объект.Организация); 
	
	Попытка		
		Если ПараметрыПодключения.Порт <= 0 Тогда 
			HTTPСоединение = Новый HTTPСоединение(ПараметрыПодключения.АдресСервера,,ПараметрыПодключения.Пользователь,ПараметрыПодключения.Пароль);
		Иначе 
			HTTPСоединение = Новый HTTPСоединение(ПараметрыПодключения.АдресСервера,ПараметрыПодключения.Порт,ПараметрыПодключения.Пользователь,ПараметрыПодключения.Пароль);
		КонецЕсли;	
	Исключение
		Сообщить("Не удалось подключиться по причине: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ДатаНачала = НачалоМесяца(Объект.ДатаПериода);
	ДатаКонца = КонецМесяца(Объект.ДатаПериода);
	//http://localhost/UAT/hs/api_uat/ItemsWriteOff?StartDate=01.04.2023&EndDate=30.04.2023
	//АдресРесурса = "/UAT/hs/api_uat/ItemsWriteOff?StartDate="+Формат(ДатаНачала,"ДЛФ=Д")+"&EndDate="+Формат(ДатаКонца,"ДЛФ=Д");
	//АдресРесурса = СокрЛП(Объект.КорневойURL) + "/StorageDocuments?StartDate="+Формат(ДатаНачала,"ДЛФ=Д")+"&EndDate="+Формат(ДатаКонца,"ДЛФ=Д") +
	//				"&GUID=" + Объект.Организация.УникальныйИдентификатор() + "&INN=" + Объект.Организация.ИНН + "&KPP=" + Объект.Организация.КПП;
	
