&НаСервере
Процедура СоздатьДокументыПотребленияТопливаИТехническихЖидкостейНаСервере(ТаблицаПотребления, Комментарий)

	СтатьяЗатратСтоимостьГСМ = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("СтатьяЗатратСтоимостьГСМ", Объект.Организация, Объект.ДатаПериода);
	
	//Обработка подразделения "Автобусная колонна (пассажирские перевозки)"
	ПодразделениеАвтоколоннаПассажирскиеПеревозки = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПодразделениеАвтоколоннаПассажирскиеПеревозки");
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаПотребленияТопливаИТехническихЖидкостей(ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
	Запрос.УстановитьПараметр("тзПотреблениеТопливаИлиТехническихЖидкостей", ТаблицаПотребления);
	Запрос.УстановитьПараметр("тзАналогиНоменклатуры", ТаблицаАналогиНоменклатуры.Выгрузить());
	Запрос.УстановитьПараметр("ПодразделениеЗатрат", ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	ВыборкаОбщийИтог.Следующий(); 

	ВыборкаПоСкладу = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаПоСкладу.Следующий() Цикл 

		Если Не ЗначениеЗаполнено(ВыборкаПоСкладу.Склад) Тогда
			Продолжить;
		КонецЕсли;	

		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Организация", Объект.Организация);
		СтруктураПараметров.Вставить("ДатаПериода", Объект.ДатаПериода);
		СтруктураПараметров.Вставить("Склад", ВыборкаПоСкладу.Склад);
		СтруктураПараметров.Вставить("Комментарий", Комментарий + " " + ПодразделениеАвтоколоннаПассажирскиеПеревозки);
		СтруктураПараметров.Вставить("СчетаУчетаЗатратВТаблице", Истина);

		ДокументТребованиеНакладная = ПолучитьДокументТребованиеНакладная(СтруктураПараметров);		 
		
		Если ДокументТребованиеНакладная.Проведен Тогда //Проведенные документы не перезаписываются!
			Продолжить;
		КонецЕсли;
		
		ДокументТребованиеНакладная.Материалы.Очистить();
		
		ВыборкаПоНоменклатуре = ВыборкаПоСкладу.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		Пока ВыборкаПоНоменклатуре.Следующий() Цикл 
			
			ВыборкаПоТранспортномуСредству = ВыборкаПоНоменклатуре.Выбрать(); 
			Пока ВыборкаПоТранспортномуСредству.Следующий() Цикл 

				НоваяСтрока = ДокументТребованиеНакладная.Материалы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПоТранспортномуСредству); 
				НоваяСтрока.Количество = ВыборкаПоТранспортномуСредству.РасходПоФакту;
				НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.ЕдиницаИзмерения;
				НоваяСтрока.Коэффициент = 1;
				НоваяСтрока.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
				НоваяСтрока.Субконто1 = СтатьяЗатратСтоимостьГСМ; 
				НоваяСтрока.Субконто3 = ВыборкаПоТранспортномуСредству.ТранспортноеСредство; 
				НоваяСтрока.СпособУчетаНДС = Перечисления.СпособыУчетаНДС.ПринимаетсяКВычету;
				
			КонецЦикла; 
			
		КонецЦикла; 
		
		ДокументТребованиеНакладная.Записать(РежимЗаписиДокумента.Запись);

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Записан документ: " + ДокументТребованиеНакладная;
		Сообщение.Сообщить();

	КонецЦикла; 
	
	//Обработка остальных категорий транспорта

	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаПотребленияТопливаИТехническихЖидкостей();
	
	Запрос.УстановитьПараметр("тзПотреблениеТопливаИлиТехническихЖидкостей", ТаблицаПотребления);
	Запрос.УстановитьПараметр("тзАналогиНоменклатуры", ТаблицаАналогиНоменклатуры.Выгрузить());
	Запрос.УстановитьПараметр("ПодразделениеЗатрат", ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	ВыборкаОбщийИтог.Следующий(); 

	ВыборкаПоСкладу = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаПоСкладу.Следующий() Цикл 

		Если Не ЗначениеЗаполнено(ВыборкаПоСкладу.Склад) Тогда
			Продолжить;
		КонецЕсли;	

		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Организация", Объект.Организация);
		СтруктураПараметров.Вставить("ДатаПериода", Объект.ДатаПериода);
		СтруктураПараметров.Вставить("Склад", ВыборкаПоСкладу.Склад);
		СтруктураПараметров.Вставить("Комментарий", Комментарий);
		СтруктураПараметров.Вставить("СчетаУчетаЗатратВТаблице", Истина);

		ДокументТребованиеНакладная = ПолучитьДокументТребованиеНакладная(СтруктураПараметров);		
		
		Если ДокументТребованиеНакладная.Проведен Тогда //Проведенные документы не перезаписываются!
			Продолжить;
		КонецЕсли;
		
		ДокументТребованиеНакладная.Материалы.Очистить();
		
		ВыборкаПоНоменклатуре = ВыборкаПоСкладу.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		Пока ВыборкаПоНоменклатуре.Следующий() Цикл 
			
			НоваяСтрока = ДокументТребованиеНакладная.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПоНоменклатуре); 
			НоваяСтрока.Количество = ВыборкаПоНоменклатуре.РасходПоФакту;
			НоваяСтрока.ЕдиницаИзмерения = НоваяСтрока.Номенклатура.ЕдиницаИзмерения;
			НоваяСтрока.Коэффициент = 1;
			НоваяСтрока.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
			НоваяСтрока.Субконто1 = СтатьяЗатратСтоимостьГСМ; 
			НоваяСтрока.СпособУчетаНДС = Перечисления.СпособыУчетаНДС.ПринимаетсяКВычету;
				
		КонецЦикла; 
		
		ДокументТребованиеНакладная.Записать(РежимЗаписиДокумента.Запись);
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Записан документ: " + ДокументТребованиеНакладная;
		Сообщение.Сообщить();
		
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыПотребленияТопливаНаСервере()
	
	СоздатьДокументыПотребленияТопливаИТехническихЖидкостейНаСервере(ТаблицаПотреблениеТоплива.Выгрузить(), "#Потребление топлива");
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыПотребленияТоплива(Команда)    
	
	СуществуютДокументыВПериоде = СуществуютДокументыПотребленияТопливаИТехническихЖидкостейВПериоде("#Потребление топлива");
	
	Если СуществуютДокументыВПериоде Тогда
		
		ТекстВопроса = НСтр("ru = 'Существующие документы будут перезаполнены. Продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ВопросПередФормированиемДокументовПотребленияТопливаЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
			НСтр("ru = 'Формирование документов'"));
	
	Иначе	
		СоздатьДокументыПотребленияТопливаНаСервере();
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ВопросПередФормированиемДокументовПотребленияТопливаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		СоздатьДокументыПотребленияТопливаНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СуществуютДокументыПотребленияТопливаИТехническихЖидкостейВПериоде(Комментарий)  
	
	Если Комментарий = "#Потребление тех. жидкостей" Тогда
		ТаблицаПотребления = ТаблицаПотреблениеТехническихЖидкостей.Выгрузить();
    Иначе
		ТаблицаПотребления = ТаблицаПотреблениеТоплива.Выгрузить();
	КонецЕсли;	
	
	//Обработка подразделения "Автобусная колонна (пассажирские перевозки)"
	ПодразделениеАвтоколоннаПассажирскиеПеревозки = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПодразделениеАвтоколоннаПассажирскиеПеревозки");
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаПотребленияТопливаИТехническихЖидкостей(ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
	Запрос.УстановитьПараметр("тзПотреблениеТопливаИлиТехническихЖидкостей", ТаблицаПотребления);
	Запрос.УстановитьПараметр("тзАналогиНоменклатуры", ТаблицаАналогиНоменклатуры.Выгрузить());
	Запрос.УстановитьПараметр("ПодразделениеЗатрат", ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	ВыборкаОбщийИтог.Следующий(); 

	ВыборкаПоСкладу = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаПоСкладу.Следующий() Цикл 

		Если Не ЗначениеЗаполнено(ВыборкаПоСкладу.Склад) Тогда
			Продолжить;
		КонецЕсли;	

		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Организация", Объект.Организация);
		СтруктураПараметров.Вставить("ДатаПериода", Объект.ДатаПериода);
		СтруктураПараметров.Вставить("Склад", ВыборкаПоСкладу.Склад);
		СтруктураПараметров.Вставить("Комментарий", Комментарий + " " + ПодразделениеАвтоколоннаПассажирскиеПеревозки);
		СтруктураПараметров.Вставить("СчетаУчетаЗатратВТаблице", Истина);

		СоздаватьДокумент = Ложь;
		ДокументТребованиеНакладная = ПолучитьДокументТребованиеНакладная(СтруктураПараметров, СоздаватьДокумент);		
					
		Если ДокументТребованиеНакладная <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;	

	КонецЦикла; 
	
	//Обработка остальных категорий транспорта

	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаПотребленияТопливаИтехническихЖидкостей();
	
	Запрос.УстановитьПараметр("тзПотреблениеТопливаИлиТехническихЖидкостей", ТаблицаПотребления);
	Запрос.УстановитьПараметр("тзАналогиНоменклатуры", ТаблицаАналогиНоменклатуры.Выгрузить());
	Запрос.УстановитьПараметр("ПодразделениеЗатрат", ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОбщийИтог = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	ВыборкаОбщийИтог.Следующий(); 

	ВыборкаПоСкладу = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаПоСкладу.Следующий() Цикл 

		Если Не ЗначениеЗаполнено(ВыборкаПоСкладу.Склад) Тогда
			Продолжить;
		КонецЕсли;	

		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Организация", Объект.Организация);
		СтруктураПараметров.Вставить("ДатаПериода", Объект.ДатаПериода);
		СтруктураПараметров.Вставить("Склад", ВыборкаПоСкладу.Склад);
		СтруктураПараметров.Вставить("Комментарий", Комментарий);
		СтруктураПараметров.Вставить("СчетаУчетаЗатратВТаблице", Истина);

		СоздаватьДокумент = Ложь;
		ДокументТребованиеНакладная = ПолучитьДокументТребованиеНакладная(СтруктураПараметров, СоздаватьДокумент);		
					
		Если ДокументТребованиеНакладная <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;	
		
	КонецЦикла; 
	
	Возврат Ложь;
	
КонецФункции	

&НаСервере
Функция СуществуютДокументыСписанияМатериаловВПериоде(Комментарий)
	
	//Проверка существования документов в периоде
	СтатьяЗатратСтоимостьЗапчастей = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("СтатьяЗатратСтоимостьЗапчастей", Объект.Организация, Объект.ДатаПериода);

	//Обработка подразделения "Автобусная колонна (пассажирские перевозки)"
	ПодразделениеАвтоколоннаПассажирскиеПеревозки = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПодразделениеАвтоколоннаПассажирскиеПеревозки");
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаСписанияМатериалов(ПодразделениеАвтоколоннаПассажирскиеПеревозки);
	
