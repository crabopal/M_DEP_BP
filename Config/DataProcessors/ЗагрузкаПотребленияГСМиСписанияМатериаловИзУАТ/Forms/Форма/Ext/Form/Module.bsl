&НаСервере
Функция ПолучитьСтруктуруДокументТМЦ(ТекущийДокумент)
	
	СтруктураДокумента = Новый Структура;

	СтруктураДокумента.Вставить("Идентификатор", ТекущийДокумент.УникальныйИдентификатор());
	СтруктураДокумента.Вставить("Номер", ТекущийДокумент.Номер);
	СтруктураДокумента.Вставить("Дата", ТекущийДокумент.Дата);
	СтруктураДокумента.Вставить("Комментарий", ТекущийДокумент.Комментарий);
	СтруктураДокумента.Вставить("Организация", ПолучитьСтруктуруОрганизация(ТекущийДокумент.Организация));
	
	Если ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		
		ЗаполнитьСтруктуруПоступлениеТоваровУслуг(СтруктураДокумента, ТекущийДокумент);
		
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		
		ЗаполнитьСтруктуруПеремещениеТоваров(СтруктураДокумента, ТекущийДокумент);
		
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.ИнвентаризацияТоваровНаСкладе") Тогда
		
		ЗаполнитьСтруктуруИнвентаризацияТоваровНаСкладе(СтруктураДокумента, ТекущийДокумент);
		
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
		
		ЗаполнитьСтруктуруАвансовыйОтчет(СтруктураДокумента, ТекущийДокумент);

	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.ОприходованиеТоваров") Тогда
		
		ЗаполнитьСтруктуруОприходованиеТоваров(СтруктураДокумента, ТекущийДокумент);

	КонецЕсли;	
		
	Возврат СтруктураДокумента;
	
КонецФункции

Функция ПолучитьСтруктуруЕдиницаИзмерения(ЕдиницаИзмерения)
	
	ГУИД = ЕдиницаИзмерения.УникальныйИдентификатор();
	СтруктураОбъекта = Новый Структура();
	СтруктураОбъекта.Вставить("Тип", "Справочник.КлассификаторЕдиницИзмерения");
	СтруктураОбъекта.Вставить("Идентификатор", ГУИД);
	
	СтруктураОбъекта.Вставить("Код", ЕдиницаИзмерения.Код);
	СтруктураОбъекта.Вставить("Наименование", ЕдиницаИзмерения.Наименование);
	СтруктураОбъекта.Вставить("ЭтоГруппа", ЕдиницаИзмерения.ЭтоГруппа);

	ОбъектУжеВыгружен = ПроверитьЧтоОбъектУжеВыгружен(ГУИД);
	Если ОбъектУжеВыгружен Тогда //Достаточно ссылки, не надо перебирать реквизиты
		Возврат СтруктураОбъекта;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ЕдиницаИзмерения.Родитель) Тогда
		СтруктураОбъекта.Вставить("Родитель", ПолучитьСтруктуруЕдиницаИзмерения(ЕдиницаИзмерения.Родитель));
	КонецЕсли;	
	
	Если Не ЕдиницаИзмерения.ЭтоГруппа Тогда
		СтруктураОбъекта.Вставить("НаименованиеПолное", ЕдиницаИзмерения.НаименованиеПолное);
	КонецЕсли;	
		
	Возврат СтруктураОбъекта;
	
КонецФункции	

&НаСервере
Функция ПолучитьСтруктуруОрганизация(Организация)
	
	СтруктураОбъекта = Новый Структура();
	СтруктураОбъекта.Вставить("Тип", "Справочник.Организации");
	СтруктураОбъекта.Вставить("Идентификатор", Организация.УникальныйИдентификатор());
	
	СтруктураОбъекта.Вставить("Код", Организация.Код);
	СтруктураОбъекта.Вставить("Наименование", Организация.Наименование);
	СтруктураОбъекта.Вставить("ИНН", Организация.ИНН);
	СтруктураОбъекта.Вставить("КПП", Организация.РегистрацияВНалоговомОргане.КПП);
		
	Возврат СтруктураОбъекта;

КонецФункции	      

&НаСервере
Функция ФункцияПреобразованияЗаписи(Свойство, Значение, ДополнительныеПараметры, Отказ) Экспорт

	Если ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
        Возврат Строка(Значение);
	Иначе
		Сообщить(ТипЗнч(Значение));
    КонецЕсли;

	Отказ = Истина;
	
КонецФункции

