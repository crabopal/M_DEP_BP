&НаСервере
Процедура ВыгрузитьДокументыТМЦвУАТНаСервере()
	
	СписокВыгруженныхОбъектов.Очистить();
	
	Сообщение = Новый СообщениеПользователю;

	Если ТаблицаДокументыТМЦ.Количество() = 0 Тогда
	    Сообщение.Текст = "Не заполнена таблица Движения ТМЦ!";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	
	//Подключение к УАТ
	ПараметрыПодключения = ЮЦАУ.ПолучитьПараметрыПодключения_УАТ(Объект.Организация); 
	
	//Получаем строку JSON с данными по сотрудникам
	СтрокаДокументыJSON = ПолучитьJSONСтрокуДокументыТМЦ();
	
	Попытка		
		Если ПараметрыПодключения.Порт <= 0 Тогда 
			HTTPСоединение = Новый HTTPСоединение(ПараметрыПодключения.АдресСервера,,ПараметрыПодключения.Пользователь,ПараметрыПодключения.Пароль);
		Иначе 
			HTTPСоединение = Новый HTTPСоединение(ПараметрыПодключения.АдресСервера,ПараметрыПодключения.Порт,ПараметрыПодключения.Пользователь,ПараметрыПодключения.Пароль);
		КонецЕсли;	
	Исключение
	    Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();
		HTTPСоединение = Неопределено;
		Возврат;
	КонецПопытки;
	
	//АдресРесурса = "/UAT/hs/api_uat/Employee/"; 
	
	КорневойURL = "/UAT/hs/api_uat";
	АдресРесурса = КорневойURL + "/StorageDocuments/";
	Заголовки = Новый Соответствие;
	
	//Отвечает за тип данных, которые будут установлены в тело запроса
	Заголовки.Вставить("Content-Type", "text/plain;charset=UTF-8");
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса, Заголовки);
	
	//Устанавливаем тело запроса
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаДокументыJSON);
	
	Попытка
	    //Отправляем данные на сервер
	    HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);

	Исключение
	    Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;	
	
	ЗаполнитьТаблицуДвиженияТМЦНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДокументыТМЦвУАТ(Команда)

	ТекущийДокумент = Элементы.ТаблицаДокументыТМЦ.ТекущиеДанные.Документ;

	ВыгрузитьДокументыТМЦвУАТНаСервере();

	//Позиционирование на текущий документ
	МассивСтрок = ТаблицаДокументыТМЦ.НайтиСтроки(Новый Структура("Документ", ТекущийДокумент));
	Если МассивСтрок.Количество() > 0 Тогда
    	 Элементы.ТаблицаДокументыТМЦ.ТекущаяСтрока = МассивСтрок[0].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьJSONСтрокуДокументыТМЦ()
	
	МассивДокументыТМЦ = Новый Массив;
	Для Каждого ТекСтрока Из ТаблицаДокументыТМЦ Цикл

		Если ТекСтрока.Пометка Тогда
			СтруктураДокументТМЦ = ПолучитьСтруктуруДокументТМЦ(ТекСтрока.Документ);		
			МассивДокументыТМЦ.Добавить(СтруктураДокументТМЦ);  
		КонецЕсли;	
		
	КонецЦикла;

	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	
	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;
	НастройкиСериализации.ФорматСериализацииДаты = ФорматДатыJSON.ISO; 
	НастройкиСериализации.СериализовыватьМассивыКакОбъекты = Ложь;
	
	ЗаписатьJSON(ЗаписьJSON, МассивДокументыТМЦ, НастройкиСериализации, "ФункцияПреобразованияЗаписи", ЭтотОбъект);
	
	СериализованнаяСтрока = ЗаписьJSON.Закрыть();
	
	Возврат СериализованнаяСтрока;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтруктуруПоступлениеТоваровУслуг(СтруктураДокумента, ТекущийДокумент)

	СтруктураДокумента.Вставить("ТипДокумента", "ПоступлениеТоваровУслуг");   
	СтруктураДокумента.Вставить("ВидОперации", Строка(ТекущийДокумент.ВидОперации));
	
	СтруктураДокумента.Вставить("ВалютаДокумента", ПолучитьСтруктуруВалюта(ТекущийДокумент.ВалютаДокумента));
	СтруктураДокумента.Вставить("НомерВходящегоДокумента", ТекущийДокумент.НомерВходящегоДокумента);
	СтруктураДокумента.Вставить("ДатаВходящегоДокумента", ТекущийДокумент.ДатаВходящегоДокумента);
	
	СтруктураДокумента.Вставить("Склад", ПолучитьСтруктуруСклад(ТекущийДокумент.Склад));
	СтруктураДокумента.Вставить("Подразделение", ПолучитьСтруктуруПодразделение(ТекущийДокумент.ПодразделениеОрганизации));
	СтруктураДокумента.Вставить("Контрагент", ПолучитьСтруктуруКонтрагент(ТекущийДокумент.Контрагент));
	СтруктураДокумента.Вставить("ДоговорКонтрагента", ПолучитьСтруктуруДоговорКонтрагента(ТекущийДокумент.ДоговорКонтрагента));
	
	СтруктураДокумента.Вставить("КратностьВзаиморасчетов", ТекущийДокумент.КратностьВзаиморасчетов);
	СтруктураДокумента.Вставить("КурсВзаиморасчетов", ТекущийДокумент.КурсВзаиморасчетов);
	СтруктураДокумента.Вставить("СуммаВключаетНДС", ТекущийДокумент.СуммаВключаетНДС);
	СтруктураДокумента.Вставить("СуммаДокумента", ТекущийДокумент.СуммаДокумента);
	
	//Обработка табличных частей
	МассивТовары = Новый Массив;
	Для Каждого ТекСтрока Из ТекущийДокумент.Товары Цикл
		
		СтруктураТовар = Новый Структура;
		
		СтруктураТовар.Вставить("Номенклатура", ПолучитьСтруктуруНоменклатура(ТекСтрока.Номенклатура));
		СтруктураТовар.Вставить("ЕдиницаИзмерения", ПолучитьСтруктуруЕдиницаИзмерения(ТекСтрока.ЕдиницаИзмерения));
		СтруктураТовар.Вставить("Количество", ТекСтрока.Количество);
		СтруктураТовар.Вставить("СтавкаНДС", Строка(ТекСтрока.СтавкаНДС));
		СтруктураТовар.Вставить("Сумма", ТекСтрока.Сумма);
		СтруктураТовар.Вставить("СуммаНДС", ТекСтрока.СуммаНДС);
		СтруктураТовар.Вставить("Цена", ТекСтрока.Цена);

		МассивТовары.Добавить(СтруктураТовар);
		
	КонецЦикла;		
	
	СтруктураДокумента.Вставить("МассивТовары", МассивТовары);
	
	МассивУслуги = Новый Массив;
	Для Каждого ТекСтрока Из ТекущийДокумент.Услуги Цикл
		
		СтруктураУслуга = Новый Структура;
		
		СтруктураУслуга.Вставить("Номенклатура", ПолучитьСтруктуруНоменклатура(ТекСтрока.Номенклатура));
		СтруктураУслуга.Вставить("Содержание", ТекСтрока.Содержание);
		СтруктураУслуга.Вставить("Количество", ТекСтрока.Количество);
		СтруктураУслуга.Вставить("СтавкаНДС", Строка(ТекСтрока.СтавкаНДС));
		СтруктураУслуга.Вставить("Сумма", ТекСтрока.Сумма);
		СтруктураУслуга.Вставить("СуммаНДС", ТекСтрока.СуммаНДС);
		СтруктураУслуга.Вставить("Цена", ТекСтрока.Цена);

		МассивУслуги.Добавить(СтруктураУслуга);
		
	КонецЦикла;		
	
	СтруктураДокумента.Вставить("МассивУслуги", МассивУслуги);
	
КонецПроцедуры	

